    /// @value(0x1000000)
    ms-strictatime,
    /// @value(0x2000000)
    ms-lazytime,
    /// @value(0x2800051)
    ms-rmt-mask,
    /// @value(0x4000000)
    ms-submount,
    /// @value(0x8000000)
    ms-noremotelock,
    /// @value(0x10000000)
    ms-nosec,
    /// @value(0x20000000)
    ms-born,
    /// @value(0x40000000)
    ms-active,
    /// @value(0x80000000)
    ms-nouser,
    /// @value(0xc0ed0000)
    ms-mgc-val,
    /// @value(0xffff0000)
    ms-mgc-msk,
  }

  /// `umount2` flags (musl `sys/mount.h`; kernel `include/linux/fs.h`).
  /// @repr(u32)
  /// @c(int)
  flags umount-flags {
    /// @value(0x1)
    mnt-force,
    /// @value(0x2)
    mnt-detach,
    /// @value(0x4)
    mnt-expire,
    /// @value(0x8)
    umount-nofollow,
  }

  /// `MOUNT_ATTR_*` (`linux/mount.h`): `mount_attr.attr_set`/`attr_clr` and `fsmount` attr flags.
  /// @repr(u64)
  flags mount-attr-flags {
    /// @value(0x0)
    mount-attr-relatime,
    /// @value(0x1)
    mount-attr-rdonly,
    /// @value(0x2)
    mount-attr-nosuid,
    /// @value(0x4)
    mount-attr-nodev,
    /// @value(0x8)
    mount-attr-noexec,
    /// @value(0x10)
    mount-attr-noatime,
    /// @value(0x20)
    mount-attr-strictatime,
    /// @name(MOUNT_ATTR__ATIME)
    /// @value(0x70)
    mount-attr-atime,
    /// @value(0x80)
    mount-attr-nodiratime,
    /// @value(0x100000)
    mount-attr-idmap,
    /// @value(0x200000)
    mount-attr-nosymfollow,
  }

  /// `move_mount` flags (`linux/mount.h`).
  /// @repr(u32)
  /// @c(unsigned)
  flags move-mount-flags {
    /// @value(0x1)
    move-mount-f-symlinks,
    /// @value(0x2)
    move-mount-f-automounts,
    /// @value(0x4)
    move-mount-f-empty-path,
    /// @value(0x10)
    move-mount-t-symlinks,
    /// @value(0x20)
    move-mount-t-automounts,
    /// @value(0x40)
    move-mount-t-empty-path,
    /// @value(0x100)
    move-mount-set-group,
    /// @value(0x200)
    move-mount-beneath,
    /// @name(MOVE_MOUNT__MASK)
    /// @value(0x377)
    move-mount-mask,
  }

  /// `open_tree` flags (`linux/mount.h`); `AT_*` flags may be ORed in.
  /// @repr(u32)
  /// @c(unsigned)
  flags open-tree-flags {
    /// @value(0x1)
    open-tree-clone,
    /// @value(0x2)
    open-tree-namespace,
  }

  /// `fsopen` flags (`linux/mount.h`).
  /// @repr(u32)
  /// @c(unsigned)
  flags fsopen-flags {
    /// @value(0x1)
    fsopen-cloexec,
  }

  /// `fsmount` flags (`linux/mount.h`).
  /// @repr(u32)
  /// @c(unsigned)
  flags fsmount-flags {
    /// @value(0x1)
    fsmount-cloexec,
    /// @value(0x2)
    fsmount-namespace,
  }

  /// `fspick` flags (`linux/mount.h`).
  /// @repr(u32)
