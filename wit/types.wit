    splice-f-gift,
  }

  /// `sync_file_range` flags (musl `fcntl.h`; kernel `include/linux/fs.h`).
  /// @repr(u32)
  /// @c(unsigned)
  flags sync-file-range-flags {
    /// @value(0x1)
    sync-file-range-wait-before,
    /// @value(0x2)
    sync-file-range-write,
    /// @value(0x4)
    sync-file-range-wait-after,
    /// @value(0x7)
    sync-file-range-write-and-wait,
  }

  /// `setxattr` family flags (`linux/xattr.h`).
  /// @repr(u32)
  /// @c(int)
  flags xattr-flags {
    /// @value(0x1)
    xattr-create,
    /// @value(0x2)
    xattr-replace,
  }

  /// `inotify_init1` flags (`linux/inotify.h`).
  /// @repr(u32)
  /// @c(int)
  flags inotify-init-flags {
    /// @value(0x800)
    in-nonblock,
    /// @value(0x80000)
    in-cloexec,
  }

  /// `inotify_add_watch` mask and `inotify_event.mask` bits (`linux/inotify.h`).
  /// @repr(u32)
  /// @c(uint32_t)
  flags inotify-mask {
    /// @value(0x1)
    in-access,
    /// @value(0x2)
    in-modify,
    /// @value(0x4)
    in-attrib,
    /// @value(0x8)
    in-close-write,
    /// @value(0x10)
    in-close-nowrite,
    /// @value(0x18)
    in-close,
    /// @value(0x20)
    in-open,
    /// @value(0x40)
    in-moved-from,
    /// @value(0x80)
    in-moved-to,
    /// @value(0xc0)
    in-move,
    /// @value(0x100)
    in-create,
    /// @value(0x200)
    in-delete,
    /// @value(0x400)
    in-delete-self,
    /// @value(0x800)
    in-move-self,
    /// @value(0xfff)
    in-all-events,
    /// @value(0x2000)
    in-unmount,
    /// @value(0x4000)
    in-q-overflow,
    /// @value(0x8000)
    in-ignored,
    /// @value(0x1000000)
    in-onlydir,
    /// @value(0x2000000)
    in-dont-follow,
    /// @value(0x4000000)
    in-excl-unlink,
    /// @value(0x10000000)
    in-mask-create,
    /// @value(0x20000000)
    in-mask-add,
    /// @value(0x40000000)
    in-isdir,
    /// @value(0x80000000)
    in-oneshot,
  }

  /// Kernel limits (`linux/limits.h`, `linux/fs.h`, `linux/xattr.h`).
  /// @repr(u32)
  enum limits {
    /// @value(4)
    xattr-hurd-prefix-len,
    /// @value(4)
    xattr-mac-osx-prefix-len,
    /// @value(5)
    xattr-user-prefix-len,
    /// @value(6)
    xattr-btrfs-prefix-len,
    /// @value(7)
    xattr-system-prefix-len,
    /// @value(8)
    xattr-trusted-prefix-len,
    /// @value(9)
    xattr-security-prefix-len,
    /// @value(13)
    xattr-name-bpf-lsm-len,
    /// @value(32)
    rtsig-max,
    /// @value(127)
    link-max,
    /// @value(255)
    name-max,
    /// @value(255)
    xattr-name-max,
    /// @value(1024)
    inr-open-cur,
    /// @value(4096)
    inr-open-max,
    /// @value(4096)
    path-max,
    /// @value(0x10000)
    /// No C assert: musl's `<limits.h>` `NGROUPS_MAX` is 32, a libc limit below the kernel's 65536.
    /// @c-skip
    ngroups-max,
    /// @value(0x10000)
    xattr-list-max,
    /// @value(0x10000)
    xattr-size-max,
    /// @value(0x20000)
    arg-max,
  }

  // ==== File handles, inode flags, ACLs, quotas and fanotify ====

  /// Limits and handle types of `name_to_handle_at` (`linux/fcntl.h` `MAX_HANDLE_SZ`,
  /// `linux/exportfs.h` `enum fid_type` and its flag bits).
  /// @repr(s32)
  enum file-handle-misc {
    /// `FILEID_ROOT`: the root of the filesystem, which some filesystems encode as such.
    /// @value(0)
    fileid-root,
    /// `FILEID_INO32_GEN`: a 32-bit inode number and a 32-bit generation.
    /// @value(1)
    fileid-ino32-gen,
    /// `FILEID_INO32_GEN_PARENT`: also the parent's inode number and generation.
    /// @value(2)
    fileid-ino32-gen-parent,
    /// `FILEID_INO64_GEN`: a 64-bit inode number and a 32-bit generation.
    /// @value(0x81)
    fileid-ino64-gen,
    /// `FILEID_INO64_GEN_PARENT`.
    /// @value(0x82)
    fileid-ino64-gen-parent,
    /// `FILEID_INVALID`.
    /// @value(0xff)
    fileid-invalid,
    /// `MAX_HANDLE_SZ`: the most bytes `name_to_handle_at` fills.
    /// @value(128)
    max-handle-sz,
    /// `FILEID_IS_CONNECTABLE`: a handle made with `AT_HANDLE_CONNECTABLE`.
    /// @value(0x10000)
    fileid-is-connectable,
    /// `FILEID_IS_DIR`: a connectable handle of a directory.
    /// @value(0x20000)
    fileid-is-dir,
  }

  /// `FS_IOC_FSGETXATTR`/`FS_IOC_FSSETXATTR` attributes (`struct fsxattr`, `linux/fs.h`).
  /// @kernel-only
  /// @size(28)
  /// @align(4)
  record fsxattr {
    fsx-xflags: u32,
    fsx-extsize: u32,
    fsx-nextents: u32,
    fsx-projid: u32,
    fsx-cowextsize: u32,
    fsx-pad: list<u8, 8>,
  }

  /// Inode flags of `FS_IOC_GETFLAGS`/`FS_IOC_SETFLAGS` (`FS_*_FL`, `linux/fs.h`; the ext2
  /// on-disk encoding).
  /// @repr(u32)
  /// @c(int)
  flags fs-inode-flags {
    /// @value(0x1)
    fs-secrm-fl,
    /// @value(0x2)
    fs-unrm-fl,
    /// @value(0x4)
    fs-compr-fl,
    /// @value(0x8)
    fs-sync-fl,
    /// @value(0x10)
    fs-immutable-fl,
    /// @value(0x20)
    fs-append-fl,
    /// @value(0x40)
    fs-nodump-fl,
    /// @value(0x80)
    fs-noatime-fl,
    /// @value(0x100)
    fs-dirty-fl,
    /// @value(0x200)
    fs-comprblk-fl,
    /// @value(0x400)
    fs-nocomp-fl,
    /// @value(0x800)
    fs-encrypt-fl,
    /// @value(0x1000)
    fs-btree-fl,
    /// @value(0x1000)
    fs-index-fl,
    /// @value(0x2000)
    fs-imagic-fl,
    /// @value(0x4000)
    fs-journal-data-fl,
    /// @value(0x8000)
    fs-notail-fl,
    /// @value(0x10000)
    fs-dirsync-fl,
    /// @value(0x20000)
    fs-topdir-fl,
    /// @value(0x40000)
    fs-huge-file-fl,
    /// @value(0x80000)
    fs-extent-fl,
    /// @value(0x100000)
    fs-verity-fl,
    /// @value(0x200000)
    fs-ea-inode-fl,
    /// @value(0x400000)
    fs-eofblocks-fl,
    /// @value(0x800000)
    fs-nocow-fl,
    /// @value(0x2000000)
    fs-dax-fl,
    /// @value(0x10000000)
    fs-inline-data-fl,
    /// @value(0x20000000)
    fs-projinherit-fl,
    /// @value(0x40000000)
    fs-casefold-fl,
    /// @value(0x80000000)
    fs-reserved-fl,
    /// @value(0x3dfff)
    fs-fl-user-visible,
    /// @value(0x380ff)
    fs-fl-user-modifiable,
  }

  /// Extended inode flags of `struct fsxattr` and `struct file_attr` (`FS_XFLAG_*`,
  /// `linux/fs.h`).
  /// @repr(u32)
