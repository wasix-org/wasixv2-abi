  flags fspick-flags {
    /// @value(0x1)
    fspick-cloexec,
    /// @value(0x2)
    fspick-symlink-nofollow,
    /// @value(0x4)
    fspick-no-automount,
    /// @value(0x8)
    fspick-empty-path,
  }

  /// `fsconfig` commands (`FSCONFIG_*`, UAPI `linux/mount.h`).
  /// @repr(u32)
  enum fsconfig-command {
    /// @value(0)
    fsconfig-set-flag,
    /// @value(1)
    fsconfig-set-string,
    /// @value(2)
    fsconfig-set-binary,
    /// @value(3)
    fsconfig-set-path,
    /// @value(4)
    fsconfig-set-path-empty,
    /// @value(5)
    fsconfig-set-fd,
    /// @value(6)
    fsconfig-cmd-create,
    /// @value(7)
    fsconfig-cmd-reconfigure,
    /// @value(8)
    fsconfig-cmd-create-excl,
  }

  /// `statmount` request and result mask (`STATMOUNT_*`, UAPI `linux/mount.h`): `mnt_id_req.param`
  /// and `statmount.mask`.
  /// @repr(u64)
  flags statmount-mask {
    /// @value(0x1)
    statmount-sb-basic,
    /// @value(0x2)
    statmount-mnt-basic,
    /// @value(0x4)
    statmount-propagate-from,
    /// @value(0x8)
    statmount-mnt-root,
    /// @value(0x10)
    statmount-mnt-point,
    /// @value(0x20)
    statmount-fs-type,
    /// @value(0x40)
    statmount-mnt-ns-id,
    /// @value(0x80)
    statmount-mnt-opts,
    /// @value(0x100)
    statmount-fs-subtype,
    /// @value(0x200)
    statmount-sb-source,
    /// @value(0x400)
    statmount-opt-array,
    /// @value(0x800)
    statmount-opt-sec-array,
    /// @value(0x1000)
    statmount-supported-mask,
    /// @value(0x2000)
    statmount-mnt-uidmap,
    /// @value(0x4000)
    statmount-mnt-gidmap,
  }

  /// `statmount` flags (UAPI `linux/mount.h`).
  /// @repr(u32)
  flags statmount-flags {
    /// `mnt_id_req.mnt_fd` names the mount instead of `mnt_id`.
    /// @value(0x1)
    statmount-by-fd,
  }

  /// `listmount` flags (UAPI `linux/mount.h`).
  /// @repr(u32)
  flags listmount-flags {
    /// @value(0x1)
    listmount-reverse,
  }

  /// `mnt_id_req.mnt_id` values with a meaning of their own (UAPI `linux/mount.h`).
  /// @repr(u64)
  enum listmount-mnt-id {
    /// The namespace's root mount.
    /// @value(0xffffffffffffffff)
    lsmt-root,
  }

  /// `mnt_id_req.size` of each published version (`MNT_ID_REQ_SIZE_VER*`, UAPI `linux/mount.h`).
  /// @repr(u32)
  enum mnt-id-req-size {
    /// @value(24)
    mnt-id-req-size-ver0,
    /// @value(32)
    mnt-id-req-size-ver1,
  }

  // ==== Dynamic linking (wasixv2 extensions) ====

  /// A loaded module, as `dlopen` returns it. In C it is a `void *`.
  /// @c(void *)
  /// @newtype
  type dl-handle = u32;

  /// @ptr(mut dl-handle)
  /// @c(void **)
  type dl-handle-ptr = uptr;

  /// The special `dlsym` handles (`dlfcn.h`). They are pointers in C, so their values are not
  /// checked against the headers.
  /// @repr(u32)
  /// @c(void *)
  enum dl-special-handle {
    /// The global scope: the main module, then `RTLD_GLOBAL` modules in load order.
    /// @value(0x0)
    /// @c-skip
    rtld-default,
    /// The modules after the caller's in the global scope.
    /// @value(0xffffffff)
    /// @c-skip
    rtld-next,
  }

  /// `dlopen` modes (`dlfcn.h`), with musl's values.
  /// @repr(u32)
  /// @c(int)
  flags dl-flags {
    /// @value(0x0)
    rtld-local,
    /// @value(0x1)
    rtld-lazy,
    /// @value(0x2)
    rtld-now,
    /// @value(0x4)
    rtld-noload,
    /// @value(0x100)
    rtld-global,
    /// @value(0x1000)
    rtld-nodelete,
  }

  // ==== Function tables (wasixv2 extensions) ====

  /// A wasm value type in `call-dynamic`, `reflect-signature` and `closure-prepare` (wasix-libc's
  /// `wasix/value_type.h`, with v1's values).
  /// @repr(u8)
  enum wasm-value-type {
    /// @value(0)
    wasix-value-type-i32,
    /// @value(1)
    wasix-value-type-i64,
    /// @value(2)
    wasix-value-type-f32,
    /// @value(3)
    wasix-value-type-f64,
    /// @value(4)
    wasix-value-type-v128,
  }

  /// `call-dynamic` flags.
  /// @repr(u32)
  flags call-dynamic-flags {
    /// Fail with `EINVAL` unless the buffers exactly match the function's signature.
    /// @value(0x1)
    call-dynamic-strict,
  }

  /// `reflect-signature`'s result (wasix-libc's `wasix_reflection_result_t`, v1's layout).
  /// @size(6)
  /// @align(2)
  record reflection-result {
    /// Non-zero if the signature at this table index never changes. Zero for closures, whose
    /// slots are reused.
    cacheable: u8,
    /// Number of arguments the function takes.
    arguments: u16,
    /// Number of results it returns.
    results: u16,
  }

  /// @ptr(mut reflection-result)
  type reflection-result-ptr = uptr;

  // ==== Sandboxing: seccomp, Landlock, keys, LSM ====

  /// `seccomp` operations (first argument; `linux/seccomp.h`).
  /// @repr(u32)
  /// @c(unsigned)
  enum seccomp-op {
    /// @value(0)
    seccomp-set-mode-strict,
    /// @value(1)
    seccomp-set-mode-filter,
    /// @value(2)
    seccomp-get-action-avail,
    /// @value(3)
    seccomp-get-notif-sizes,
  }

  /// A task's seccomp mode, as `PR_GET_SECCOMP` and `/proc/[pid]/status` report it
  /// (`linux/seccomp.h`).
  /// @repr(u32)
  /// @c(unsigned)
  enum seccomp-mode {
    /// @value(0)
    seccomp-mode-disabled,
    /// @value(1)
    seccomp-mode-strict,
    /// @value(2)
    seccomp-mode-filter,
  }

  /// `SECCOMP_SET_MODE_FILTER` flags (`linux/seccomp.h`).
  /// @repr(u32)
  /// @c(unsigned)
  flags seccomp-filter-flags {
    /// @value(0x1)
    seccomp-filter-flag-tsync,
    /// @value(0x2)
    seccomp-filter-flag-log,
    /// @value(0x4)
    seccomp-filter-flag-spec-allow,
    /// @value(0x8)
    seccomp-filter-flag-new-listener,
    /// @value(0x10)
    seccomp-filter-flag-tsync-esrch,
    /// @value(0x20)
    seccomp-filter-flag-wait-killable-recv,
  }

  /// What a seccomp filter returns: an action in the high 16 bits (`SECCOMP_RET_ACTION_FULL`)
  /// and data in the low 16 (`SECCOMP_RET_DATA`) (`linux/seccomp.h`).
  /// @repr(u32)
  /// @c(unsigned)
  enum seccomp-ret {
    /// @value(0x80000000)
    seccomp-ret-kill-process,
    /// @value(0x0)
    seccomp-ret-kill-thread,
    /// @value(0x0)
    seccomp-ret-kill,
    /// @value(0x30000)
    seccomp-ret-trap,
    /// @value(0x50000)
    seccomp-ret-errno,
    /// @value(0x7fc00000)
    seccomp-ret-user-notif,
    /// @value(0x7ff00000)
    seccomp-ret-trace,
    /// @value(0x7ffc0000)
    seccomp-ret-log,
    /// @value(0x7fff0000)
    seccomp-ret-allow,
    /// @value(0xffff0000)
    seccomp-ret-action-full,
    /// @value(0x7fff0000)
    seccomp-ret-action,
    /// @value(0xffff)
    seccomp-ret-data,
  }

  /// `seccomp_notif_resp.flags` and `SECCOMP_IOCTL_NOTIF_SET_FLAGS` flags, and
  /// `seccomp_notif_addfd.flags` (`linux/seccomp.h`).
  /// @repr(u32)
  /// @c(unsigned)
  flags seccomp-notif-flags {
    /// `SECCOMP_USER_NOTIF_FLAG_CONTINUE` (response) and `SECCOMP_USER_NOTIF_FD_SYNC_WAKE_UP`
    /// (`SET_FLAGS`).
    /// @value(0x1)
    seccomp-user-notif-flag-continue,
    /// @value(0x1)
    seccomp-user-notif-fd-sync-wake-up,
    /// @value(0x1)
    seccomp-addfd-flag-setfd,
    /// @value(0x2)
    seccomp-addfd-flag-send,
  }

  /// `seccomp_data.arch` and `si_arch` of wasixv2 tasks: riscv32's (`AUDIT_ARCH_RISCV32`,
  /// `EM_RISCV | __AUDIT_ARCH_LE`, `linux/audit.h`), whose syscall table the ABI follows.
  /// @repr(u32)
  /// @c(unsigned)
  enum audit-arch {
    /// @value(0x400000f3)
    audit-arch-riscv32,
  }

  /// What a seccomp filter runs over (`struct seccomp_data`): `nr` is the riscv32 syscall number
  /// and `args` its six registers, each zero-extended. wasm has no program counter, so
  /// `instruction-pointer` is 0.
  /// @kernel-only
  /// @size(64)
  /// @align(8)
  record seccomp-data {
    nr: s32,
    arch: u32,
    instruction-pointer: u64,
    args: list<u64, 6>,
  }

  /// `SECCOMP_GET_NOTIF_SIZES` result (`struct seccomp_notif_sizes`).
  /// @kernel-only
  /// @size(6)
  /// @align(2)
  record seccomp-notif-sizes {
    seccomp-notif: u16,
    seccomp-notif-resp: u16,
    seccomp-data: u16,
  }

  /// A user notification (`struct seccomp_notif`), read with `SECCOMP_IOCTL_NOTIF_RECV`.
  /// @kernel-only
  /// @size(80)
  /// @align(8)
  record seccomp-notif {
    id: u64,
    pid: u32,
    %flags: u32,
    data: seccomp-data,
  }

  /// The answer to a user notification (`struct seccomp_notif_resp`).
  /// @kernel-only
  /// @size(24)
  /// @align(8)
  record seccomp-notif-resp {
    id: u64,
    val: s64,
    error: s32,
    %flags: u32,
  }

  /// `SECCOMP_IOCTL_NOTIF_ADDFD` argument (`struct seccomp_notif_addfd`).
  /// @kernel-only
  /// @size(24)
  /// @align(8)
  record seccomp-notif-addfd {
    id: u64,
    %flags: u32,
    srcfd: u32,
    newfd: u32,
    newfd-flags: u32,
  }

  /// `landlock_create_ruleset` flags (`linux/landlock.h`).
  /// @repr(u32)
  /// @c(unsigned)
  flags landlock-create-ruleset-flags {
    /// @value(0x1)
    landlock-create-ruleset-version,
    /// @value(0x2)
    landlock-create-ruleset-errata,
