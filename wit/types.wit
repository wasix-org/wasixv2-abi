  /// `fcntl64` commands (`asm-generic/fcntl.h`, `linux/fcntl.h`).
  /// Kernel spelling: `F_GETLK`/`F_SETLK`/`F_SETLKW` (5/6/7) take the legacy 16-byte `struct flock`; musl on
  /// riscv32 defines `F_GETLK` as 12 (= `F_GETLK64`) and only ever passes `flock64`.
  /// @repr(s32)
  /// @c(int)
  enum fcntl-cmd {
    /// @value(0)
    f-dupfd,
    /// @value(1)
    f-getfd,
    /// @value(2)
    f-setfd,
    /// @value(3)
    f-getfl,
    /// @value(4)
    f-setfl,
    /// @value(5)
    /// No C assert: musl defines `F_GETLK` as `F_GETLK64` (12) on 32-bit and only passes `flock64`.
    /// @c-skip
    f-getlk,
    /// @value(6)
    /// No C assert: musl defines `F_SETLK` as `F_SETLK64` (13) on 32-bit and only passes `flock64`.
    /// @c-skip
    f-setlk,
    /// @value(7)
    /// No C assert: musl defines `F_SETLKW` as `F_SETLKW64` (14) on 32-bit and only passes `flock64`.
    /// @c-skip
    f-setlkw,
    /// @value(8)
    f-setown,
    /// @value(9)
    f-getown,
    /// @value(10)
    f-setsig,
    /// @value(11)
    f-getsig,
    /// @value(12)
    f-getlk64,
    /// @value(13)
    f-setlk64,
    /// @value(14)
    f-setlkw64,
    /// @value(15)
    f-setown-ex,
    /// @value(16)
    f-getown-ex,
    /// @value(17)
    f-getowner-uids,
    /// @value(36)
    f-ofd-getlk,
    /// @value(37)
    f-ofd-setlk,
    /// @value(38)
    f-ofd-setlkw,
    /// @value(1024)
    f-linux-specific-base,
    /// @value(1024)
    f-setlease,
    /// @value(1025)
    f-getlease,
    /// @value(1026)
    f-notify,
    /// @value(1027)
    f-dupfd-query,
    /// @value(1028)
    f-created-query,
    /// @value(1029)
    f-cancellk,
    /// @value(1030)
    f-dupfd-cloexec,
    /// @value(1031)
    f-setpipe-sz,
    /// @value(1032)
    f-getpipe-sz,
    /// @value(1033)
    f-add-seals,
    /// @value(1034)
    f-get-seals,
    /// @value(1035)
    f-get-rw-hint,
    /// @value(1036)
    f-set-rw-hint,
    /// @value(1037)
    f-get-file-rw-hint,
    /// @value(1038)
    f-set-file-rw-hint,
    /// @value(1039)
    f-getdeleg,
    /// @value(1040)
    f-setdeleg,
  }

