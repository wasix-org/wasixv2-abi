    /// @value(36)
    tcp-cm-inq,
    /// @value(36)
    tcp-inq,
    /// @value(37)
    tcp-tx-delay,
  }

  /// TCP connection states (`tcp_info.tcpi_state`).
  /// @repr(s32)
  enum tcp-state {
    /// @value(1)
    tcp-established,
    /// @value(2)
    tcp-syn-sent,
    /// @value(3)
    tcp-syn-recv,
    /// @value(6)
    tcp-time-wait,
    /// @value(7)
    tcp-close,
    /// @value(8)
    tcp-close-wait,
    /// @value(9)
    tcp-last-ack,
    /// @value(10)
    tcp-listen,
    /// @value(11)
    tcp-closing,
  }

  /// TCP congestion avoidance states.
  /// @repr(s32)
  enum tcp-ca-state {
    /// @value(2)
    tcp-ca-cwr,
  }

  /// Values for `TCP_REPAIR`.
  /// @repr(s32)
  enum tcp-repair-mode {
    /// @value(0)
    tcp-repair-off,
    /// @value(1)
    tcp-repair-on,
    /// @value(-1)
    tcp-repair-off-no-wp,
  }

  /// `TCP_ZEROCOPY_RECEIVE` flags.
  /// @repr(u32)
  flags tcp-zerocopy-flags {
    /// @value(0x1)
    tcp-receive-zerocopy-flag-tlb-clean-hint,
  }

  // ==== Socket families: vsock and sock_diag ====

  /// `AF_VSOCK` socket address (`struct sockaddr_vm`, UAPI `linux/vm_sockets.h`, which musl
  /// does not have).
  /// @kernel-only
  /// @size(16)
  /// @align(4)
  record sockaddr-vm {
    svm-family: sa-family,
    svm-reserved1: u16,
    svm-port: u32,
    svm-cid: u32,
    /// `vmaddr-flags`.
    svm-flags: u8,
    svm-zero: list<u8, 3>,
  }

  /// Well-known vsock context identifiers and ports (`VMADDR_*`).
  /// @repr(u32)
  enum vmaddr {
    /// @value(0)
    vmaddr-cid-hypervisor,
    /// @value(1)
    vmaddr-cid-local,
    /// @value(2)
    vmaddr-cid-host,
    /// @value(0xffffffff)
    vmaddr-cid-any,
    /// @value(0xffffffff)
    vmaddr-port-any,
  }

  /// `svm_flags` bits.
  /// @repr(u8)
  flags vmaddr-flags {
    /// @value(0x1)
    vmaddr-flag-to-host,
  }

  /// `AF_VSOCK`-level socket options (`SO_VM_SOCKETS_*`).
  /// @repr(s32)
  enum vsock-option {
    /// @value(0)
    so-vm-sockets-buffer-size,
    /// @value(1)
    so-vm-sockets-buffer-min-size,
    /// @value(2)
    so-vm-sockets-buffer-max-size,
    /// @value(3)
    so-vm-sockets-peer-host-vm-id,
    /// @value(5)
    so-vm-sockets-trusted,
    /// @value(6)
    so-vm-sockets-connect-timeout-old,
    /// @value(7)
    so-vm-sockets-nonblock-txrx,
    /// @value(8)
    so-vm-sockets-connect-timeout-new,
  }

  /// `sock_diag` request header (`struct sock_diag_req`, UAPI `linux/sock_diag.h`).
  /// @kernel-only
  /// @size(2)
  /// @align(1)
  record sock-diag-req {
    sdiag-family: u8,
    sdiag-protocol: u8,
  }

  /// A socket's identity in `inet_diag` (`struct inet_diag_sockid`, UAPI `linux/inet_diag.h`).
  /// Ports and addresses are big-endian; an IPv4 address takes the first word of its array.
  /// @kernel-only
  /// @size(48)
  /// @align(4)
  record inet-diag-sockid {
    idiag-sport: u16,
    idiag-dport: u16,
    idiag-src: list<u32, 4>,
    idiag-dst: list<u32, 4>,
    idiag-if: u32,
    idiag-cookie: list<u32, 2>,
  }

  /// `SOCK_DIAG_BY_FAMILY` request for `AF_INET`/`AF_INET6` (`struct inet_diag_req_v2`).
  /// @kernel-only
  /// @size(56)
  /// @align(4)
  record inet-diag-req-v2 {
    sdiag-family: u8,
    sdiag-protocol: u8,
    /// Bits `1 << (INET_DIAG_* - 1)` of the attributes to add.
    idiag-ext: u8,
    pad: u8,
    /// Bits `1 << TCP_*` of the states to dump.
    idiag-states: u32,
    id: inet-diag-sockid,
  }

  /// The legacy `TCPDIAG_GETSOCK`/`DCCPDIAG_GETSOCK` request (`struct inet_diag_req`).
  /// @kernel-only
  /// @size(60)
  /// @align(4)
  record inet-diag-req {
    idiag-family: u8,
    idiag-src-len: u8,
    idiag-dst-len: u8,
    idiag-ext: u8,
    id: inet-diag-sockid,
    idiag-states: u32,
    idiag-dbs: u32,
  }

  /// One socket of an `inet_diag` dump (`struct inet_diag_msg`).
  /// @kernel-only
  /// @size(72)
  /// @align(4)
  record inet-diag-msg {
    idiag-family: u8,
    idiag-state: u8,
    idiag-timer: u8,
    idiag-retrans: u8,
    id: inet-diag-sockid,
    idiag-expires: u32,
    idiag-rqueue: u32,
    idiag-wqueue: u32,
    idiag-uid: u32,
    idiag-inode: u32,
  }

  /// `INET_DIAG_MEMINFO` attribute (`struct inet_diag_meminfo`).
  /// @kernel-only
  /// @size(16)
  /// @align(4)
  record inet-diag-meminfo {
    idiag-rmem: u32,
    idiag-wmem: u32,
    idiag-fmem: u32,
    idiag-tmem: u32,
  }

  /// `SOCK_DIAG_BY_FAMILY` request for `AF_UNIX` (`struct unix_diag_req`, UAPI
  /// `linux/unix_diag.h`).
  /// @kernel-only
  /// @size(24)
  /// @align(4)
  record unix-diag-req {
    sdiag-family: u8,
    sdiag-protocol: u8,
    pad: u16,
    /// Bits `1 << TCP_*` of the states to dump.
    udiag-states: u32,
    udiag-ino: u32,
    /// `UDIAG_SHOW_*` bits.
    udiag-show: u32,
    udiag-cookie: list<u32, 2>,
  }

  /// One socket of a `unix_diag` dump (`struct unix_diag_msg`).
  /// @kernel-only
  /// @size(16)
  /// @align(4)
  record unix-diag-msg {
    udiag-family: u8,
    udiag-type: u8,
    udiag-state: u8,
    pad: u8,
    udiag-ino: u32,
    udiag-cookie: list<u32, 2>,
  }

  /// `UNIX_DIAG_RQLEN` attribute (`struct unix_diag_rqlen`).
  /// @kernel-only
  /// @size(8)
  /// @align(4)
  record unix-diag-rqlen {
    udiag-rqueue: u32,
    udiag-wqueue: u32,
  }

  /// `UNIX_DIAG_VFS` attribute (`struct unix_diag_vfs`).
  /// @kernel-only
  /// @size(8)
  /// @align(4)
  record unix-diag-vfs {
    udiag-vfs-ino: u32,
    udiag-vfs-dev: u32,
  }

  /// `SCTP_INITMSG` and the `SCTP_INIT` control message (`struct sctp_initmsg`, UAPI `linux/sctp.h`, which musl does not have).
  /// @kernel-only
  /// @size(8)
  /// @align(2)
  record sctp-initmsg {
    sinit-num-ostreams: u16,
    sinit-max-instreams: u16,
    sinit-max-attempts: u16,
    sinit-max-init-timeo: u16,
  }

  /// `SCTP_SNDRCV` control message and `SCTP_DEFAULT_SEND_PARAM` (`struct sctp_sndrcvinfo`); `sinfo-flags` holds `sctp-sinfo-flags`.
  /// @kernel-only
  /// @size(32)
  /// @align(4)
  record sctp-sndrcvinfo {
    sinfo-stream: u16,
    sinfo-ssn: u16,
    sinfo-flags: u16,
    sinfo-ppid: u32,
    sinfo-context: u32,
    sinfo-timetolive: u32,
    sinfo-tsn: u32,
    sinfo-cumtsn: u32,
    sinfo-assoc-id: s32,
  }

  /// `SCTP_SNDINFO` control message and `SCTP_DEFAULT_SNDINFO` (`struct sctp_sndinfo`).
  /// @kernel-only
  /// @size(16)
  /// @align(4)
  record sctp-sndinfo {
    snd-sid: u16,
    snd-flags: u16,
    snd-ppid: u32,
    snd-context: u32,
    snd-assoc-id: s32,
  }

  /// `SCTP_RCVINFO` control message (`struct sctp_rcvinfo`).
  /// @kernel-only
  /// @size(28)
  /// @align(4)
  record sctp-rcvinfo {
    rcv-sid: u16,
    rcv-ssn: u16,
    rcv-flags: u16,
    rcv-ppid: u32,
    rcv-tsn: u32,
    rcv-cumtsn: u32,
    rcv-context: u32,
    rcv-assoc-id: s32,
  }

  /// `SCTP_NXTINFO` control message (`struct sctp_nxtinfo`).
  /// @kernel-only
  /// @size(16)
  /// @align(4)
  record sctp-nxtinfo {
    nxt-sid: u16,
    nxt-flags: u16,
    nxt-ppid: u32,
    nxt-length: u32,
    nxt-assoc-id: s32,
  }

  /// `SCTP_EVENTS` (`struct sctp_event_subscribe`): one byte per notification. The last field is the kernel's `sctp_send_failure_event_event`.
  /// @kernel-only
  /// @size(14)
  /// @align(1)
  record sctp-event-subscribe {
    sctp-data-io-event: u8,
    sctp-association-event: u8,
    sctp-address-event: u8,
    sctp-send-failure-event: u8,
    sctp-peer-error-event: u8,
    sctp-shutdown-event: u8,
    sctp-partial-delivery-event: u8,
    sctp-adaptation-layer-event: u8,
    sctp-authentication-event: u8,
    sctp-sender-dry-event: u8,
    sctp-stream-reset-event: u8,
    sctp-assoc-reset-event: u8,
    sctp-stream-change-event: u8,
    sctp-send-failure-event-event: u8,
  }

  /// `SCTP_EVENT` (`struct sctp_event`): one notification type on or off.
  /// @kernel-only
  /// @size(8)
  /// @align(4)
  record sctp-event {
    se-assoc-id: s32,
    se-type: u16,
    se-on: u8,
    se-pad: u8,
  }

  /// `SCTP_RTOINFO` (`struct sctp_rtoinfo`), in milliseconds.
  /// @kernel-only
  /// @size(16)
  /// @align(4)
  record sctp-rtoinfo {
    srto-assoc-id: s32,
    srto-initial: u32,
    srto-max: u32,
    srto-min: u32,
  }

  /// `SCTP_ASSOCINFO` (`struct sctp_assocparams`).
  /// @kernel-only
  /// @size(20)
  /// @align(4)
  record sctp-assocparams {
    sasoc-assoc-id: s32,
    sasoc-asocmaxrxt: u16,
    sasoc-number-peer-destinations: u16,
    sasoc-peer-rwnd: u32,
    sasoc-local-rwnd: u32,
    sasoc-cookie-life: u32,
  }

  /// `SCTP_MAXSEG`, `SCTP_CONTEXT`, `SCTP_MAX_BURST` and the like (`struct sctp_assoc_value`).
  /// @kernel-only
  /// @size(8)
  /// @align(4)
  record sctp-assoc-value {
    assoc-id: s32,
    assoc-value: u32,
  }

  /// `SCTP_GET_PEER_ADDRS`/`SCTP_GET_LOCAL_ADDRS` header (`struct sctp_getaddrs`); the packed addresses follow it.
  /// @kernel-only
  /// @size(8)
  /// @align(4)
  record sctp-getaddrs {
    assoc-id: s32,
    addr-num: u32,
  }

  /// `SCTP_ASSOC_CHANGE` notification (`struct sctp_assoc_change`); `sac-state` is `sctp-sac-state`. Variable data may follow.
  /// @kernel-only
  /// @size(20)
  /// @align(4)
  record sctp-assoc-change {
    sac-type: u16,
    sac-flags: u16,
    sac-length: u32,
    sac-state: u16,
    sac-error: u16,
    sac-outbound-streams: u16,
    sac-inbound-streams: u16,
    sac-assoc-id: s32,
  }

  /// `SCTP_SHUTDOWN_EVENT` notification (`struct sctp_shutdown_event`).
  /// @kernel-only
  /// @size(12)
  /// @align(4)
  record sctp-shutdown-event {
    sse-type: u16,
    sse-flags: u16,
    sse-length: u32,
    sse-assoc-id: s32,
  }

  /// `SCTP_SENDER_DRY_EVENT` notification (`struct sctp_sender_dry_event`).
  /// @kernel-only
  /// @size(12)
  /// @align(4)
  record sctp-sender-dry-event {
    sender-dry-type: u16,
    sender-dry-flags: u16,
    sender-dry-length: u32,
    sender-dry-assoc-id: s32,
  }

  /// `SCTP_GET_PEER_ADDR_INFO` and `sctp-status`' primary path (`struct sctp_paddrinfo`, packed
  /// and 4-aligned, which on wasm32 leaves every field at its natural offset); `spinfo-state` is
  /// `sctp-spinfo-state`.
  /// @kernel-only
  /// @size(152)
  /// @align(4)
  record sctp-paddrinfo {
    spinfo-assoc-id: s32,
    spinfo-address: sockaddr-storage,
    spinfo-state: s32,
    spinfo-cwnd: u32,
    spinfo-srtt: u32,
    spinfo-rto: u32,
    spinfo-mtu: u32,
  }

  /// `SCTP_STATUS` (`struct sctp_status`); `sstat-state` is `sctp-sstat-state`.
  /// @kernel-only
  /// @size(176)
  /// @align(4)
  record sctp-status {
    sstat-assoc-id: s32,
    sstat-state: s32,
    sstat-rwnd: u32,
    sstat-unackdata: u16,
    sstat-penddata: u16,
    sstat-instrms: u16,
    sstat-outstrms: u16,
    sstat-fragmentation-point: u32,
    sstat-primary: sctp-paddrinfo,
  }

  /// `SCTP_PRIMARY_ADDR` (`struct sctp_prim`, packed and 4-aligned).
  /// @kernel-only
  /// @size(132)
  /// @align(4)
  record sctp-prim {
    ssp-assoc-id: s32,
    ssp-addr: sockaddr-storage,
  }

  /// `SCTP_SOCKOPT_PEELOFF` (`sctp_peeloff_arg_t`): in, the association; out, the new descriptor.
  /// @kernel-only
  /// @size(8)
  /// @align(4)
  record sctp-peeloff-arg {
    associd: s32,
    sd: s32,
  }

  /// `SCTP_SOCKOPT_PEELOFF_FLAGS` (`sctp_peeloff_flags_arg_t`); `flags` takes `SOCK_CLOEXEC` and
  /// `SOCK_NONBLOCK`.
  /// @kernel-only
  /// @size(12)
  /// @align(4)
  record sctp-peeloff-flags-arg {
    p-arg: sctp-peeloff-arg,
    %flags: u32,
  }

  /// `SCTP_SOCKOPT_CONNECTX3` (`struct sctp_getaddrs_old`): `addr-num` bytes of packed addresses
  /// at `addrs`; the association id is written back over `assoc-id`.
  /// @kernel-only
  /// @size(12)
  /// @align(4)
  record sctp-getaddrs-old {
    assoc-id: s32,
    addr-num: s32,
    addrs: const-sockaddr-ptr,
  }

  /// `sstat_state` of `SCTP_STATUS` (`enum sctp_sstat_state`).
  /// @repr(s32)
  enum sctp-sstat-state {
    /// @value(0)
    sctp-empty,
    /// @value(1)
    sctp-closed,
    /// @value(2)
    sctp-cookie-wait,
    /// @value(3)
    sctp-cookie-echoed,
    /// @value(4)
    sctp-established,
    /// @value(5)
    sctp-shutdown-pending,
    /// @value(6)
    sctp-shutdown-sent,
    /// @value(7)
    sctp-shutdown-received,
    /// @value(8)
    sctp-shutdown-ack-sent,
  }

  /// `spinfo_state` of a peer address (`enum sctp_spinfo_state`).
  /// @repr(s32)
  enum sctp-spinfo-state {
    /// @value(0)
    sctp-inactive,
    /// @value(1)
    sctp-pf,
    /// @value(2)
    sctp-active,
    /// @value(3)
    sctp-unconfirmed,
    /// @value(0xffff)
    sctp-unknown,
  }

  /// `SOL_SCTP` socket options (UAPI `linux/sctp.h`).
  /// @repr(s32)
  enum sctp-option {
    /// @value(0)
    sctp-rtoinfo,
    /// @value(1)
    sctp-associnfo,
    /// @value(2)
    sctp-initmsg,
    /// @value(3)
    sctp-nodelay,
    /// @value(4)
    sctp-autoclose,
    /// @value(5)
    sctp-set-peer-primary-addr,
    /// @value(6)
    sctp-primary-addr,
    /// @value(7)
    sctp-adaptation-layer,
    /// @value(8)
    sctp-disable-fragments,
    /// @value(9)
    sctp-peer-addr-params,
    /// @value(10)
    sctp-default-send-param,
    /// @value(11)
    sctp-events,
    /// @value(12)
    sctp-i-want-mapped-v4-addr,
    /// @value(13)
    sctp-maxseg,
    /// @value(14)
    sctp-status,
    /// @value(15)
    sctp-get-peer-addr-info,
    /// @value(16)
    sctp-delayed-ack-time,
    /// @value(17)
    sctp-context,
    /// @value(18)
    sctp-fragment-interleave,
    /// @value(19)
    sctp-partial-delivery-point,
    /// @value(20)
    sctp-max-burst,
    /// @value(28)
    sctp-get-assoc-number,
    /// @value(29)
    sctp-get-assoc-id-list,
    /// @value(32)
    sctp-recvrcvinfo,
    /// @value(33)
    sctp-recvnxtinfo,
    /// @value(34)
    sctp-default-sndinfo,
    /// @value(36)
    sctp-reuse-port,
    /// @value(100)
    sctp-sockopt-bindx-add,
    /// @value(101)
    sctp-sockopt-bindx-rem,
    /// @value(102)
    sctp-sockopt-peeloff,
    /// @value(107)
    sctp-sockopt-connectx-old,
    /// @value(108)
    sctp-get-peer-addrs,
    /// @value(109)
    sctp-get-local-addrs,
    /// @value(110)
    sctp-sockopt-connectx,
    /// @value(111)
    sctp-sockopt-connectx3,
    /// @value(113)
    sctp-pr-supported,
    /// @value(114)
    sctp-default-prinfo,
    /// @value(122)
    sctp-sockopt-peeloff-flags,
    /// @value(127)
    sctp-event,
  }

  /// `SOL_SCTP` control message types (`enum sctp_cmsg_type`).
  /// @repr(s32)
  enum sctp-cmsg-type {
    /// @value(0)
    sctp-init,
    /// @value(1)
    sctp-sndrcv,
    /// @value(2)
    sctp-sndinfo,
    /// @value(3)
    sctp-rcvinfo,
    /// @value(4)
    sctp-nxtinfo,
    /// @value(5)
    sctp-prinfo,
    /// @value(6)
    sctp-authinfo,
    /// @value(7)
    sctp-dstaddrv4,
    /// @value(8)
    sctp-dstaddrv6,
  }

  /// `sinfo_flags`/`snd_flags` bits (`enum sctp_sinfo_flags`).
  /// @repr(u16)
  flags sctp-sinfo-flags {
    /// @value(0x1)
    sctp-unordered,
    /// @value(0x2)
    sctp-addr-over,
    /// @value(0x4)
    sctp-abort,
    /// @value(0x8)
    sctp-sack-immediately,
    /// @value(0x40)
    sctp-sendall,
    /// @value(0x80)
    sctp-pr-sctp-all,
    /// `MSG_FIN`.
    /// @value(0x200)
    sctp-eof,
    /// `MSG_NOTIFICATION`.
    /// @value(0x8000)
    sctp-notification,
  }

  /// Notification types (`enum sctp_sn_type`).
  /// @repr(u16)
  enum sctp-sn-type {
    /// @value(32768)
    sctp-data-io-event,
    /// @value(32769)
    sctp-assoc-change,
    /// @value(32770)
    sctp-peer-addr-change,
    /// @value(32771)
    sctp-send-failed,
    /// @value(32772)
    sctp-remote-error,
    /// @value(32773)
    sctp-shutdown-event,
    /// @value(32774)
    sctp-partial-delivery-event,
    /// @value(32775)
    sctp-adaptation-indication,
    /// @value(32776)
    sctp-authentication-event,
    /// @value(32777)
    sctp-sender-dry-event,
    /// @value(32778)
    sctp-stream-reset-event,
    /// @value(32779)
    sctp-assoc-reset-event,
    /// @value(32780)
    sctp-stream-change-event,
    /// @value(32781)
    sctp-send-failed-event,
  }

  /// `sac_state` of an `SCTP_ASSOC_CHANGE` (`enum sctp_sac_state`).
  /// @repr(u16)
  enum sctp-sac-state {
    /// @value(0)
    sctp-comm-up,
    /// @value(1)
    sctp-comm-lost,
    /// @value(2)
    sctp-restart,
    /// @value(3)
    sctp-shutdown-comp,
    /// @value(4)
    sctp-cant-str-assoc,
  }

  // ==== System V IPC ====

  /// IPC permissions (asm-generic `struct ipc64_perm`). The zero-length `__pad1` is omitted.
  /// @c(struct ipc_perm)
  /// @size(36)
  /// @align(4)
  record ipc64-perm {
    key: key,
    uid: uid,
    gid: gid,
    cuid: uid,
    cgid: gid,
    mode: mode,
    /// musl: `int __ipc_perm_seq`, covering `seq` and `__pad2` (little-endian).
    /// @c-name(__ipc_perm_seq)
    seq: u16,
    /// No C assert: part of musl's 32-bit `__ipc_perm_seq`.
    /// @c-skip
    pad2: u16,
    /// musl: `__pad1`.
    /// @c-name(__pad1)
    unused1: ulong,
    /// musl: `__pad2`.
    /// @c-name(__pad2)
    unused2: ulong,
  }

  /// `msgctl` buffer (asm-generic `struct msqid64_ds`, times split into low/high words).
  /// musl's 112-byte `struct msqid_ds` differs; it converts.
  /// @kernel-only
  /// @size(88)
  /// @align(4)
  record msqid64-ds {
    msg-perm: ipc64-perm,
    msg-stime: ulong,
    msg-stime-high: ulong,
    msg-rtime: ulong,
    msg-rtime-high: ulong,
    msg-ctime: ulong,
    msg-ctime-high: ulong,
    msg-cbytes: ulong,
    msg-qnum: ulong,
    msg-qbytes: ulong,
    msg-lspid: pid,
    msg-lrpid: pid,
    /// @c-name(__unused4)
    unused4: ulong,
    /// @c-name(__unused5)
    unused5: ulong,
  }

  /// `semctl` buffer (asm-generic `struct semid64_ds`), passed through the `semun` argument.
  /// @kernel-only
  /// @size(64)
  /// @align(4)
  record semid64-ds {
    sem-perm: ipc64-perm,
    sem-otime: ulong,
    sem-otime-high: ulong,
    sem-ctime: ulong,
    sem-ctime-high: ulong,
    sem-nsems: ulong,
    /// @c-name(__unused3)
    unused3: ulong,
    /// @c-name(__unused4)
    unused4: ulong,
  }

  /// `shmctl` buffer (asm-generic `struct shmid64_ds`).
  /// @kernel-only
  /// @size(84)
  /// @align(4)
  record shmid64-ds {
    shm-perm: ipc64-perm,
    shm-segsz: usize,
    shm-atime: ulong,
    shm-atime-high: ulong,
    shm-dtime: ulong,
    shm-dtime-high: ulong,
    shm-ctime: ulong,
    shm-ctime-high: ulong,
    shm-cpid: pid,
    shm-lpid: pid,
    shm-nattch: ulong,
    /// @c-name(__unused4)
    unused4: ulong,
    /// @c-name(__unused5)
    unused5: ulong,
  }

  /// `semop`/`semtimedop_time64` operation (`struct sembuf`).
  /// @c(struct sembuf)
  /// @size(6)
  /// @align(2)
  record sembuf {
    sem-num: u16,
    sem-op: s16,
    /// `sem-flags` bits (plus `IPC_NOWAIT`).
    sem-flg: s16,
  }

  /// Message buffer header (`struct msgbuf`); `msgsz` bytes of text start at offset 4.
  /// @c(struct msgbuf)
  /// @size(8)
  /// @align(4)
  record msgbuf {
    mtype: slong,
    mtext: list<u8, 1>,
  }

  /// POSIX message queue attributes (`struct mq_attr`).
  /// @c(struct mq_attr)
  /// @size(32)
  /// @align(4)
  record mq-attr {
    mq-flags: slong,
    mq-maxmsg: slong,
    mq-msgsize: slong,
    mq-curmsgs: slong,
    /// musl: `__unused`.
    /// @c-name(__unused)
    reserved: list<slong, 4>,
  }

  /// Special SysV IPC keys (`linux/ipc.h`).
  /// @repr(s32)
  /// @c(key_t)
  enum ipc-key {
    /// @value(0)
    ipc-private,
  }

  /// `msgget`/`semget`/`shmget` flags (`IPC_*`; low 9 bits carry permissions).
  /// @repr(u32)
  /// @c(int)
  flags ipc-flags {
    /// @value(0x200)
    ipc-creat,
    /// @value(0x400)
    ipc-excl,
    /// @value(0x800)
    ipc-nowait,
    /// @value(0x1000)
    ipc-dipc,
    /// @value(0x2000)
    ipc-own,
  }

  /// `msgctl`/`semctl`/`shmctl` commands (`linux/ipc.h`, `msg.h`, `sem.h`, `shm.h`).
  /// On most 32-bit arches `IPC_64` is ORed in; musl riscv32 (and wasixv2) passes commands without it.
  /// @repr(s32)
  /// @c(int)
  enum ipc-cmd {
    /// @value(0)
    ipc-old,
    /// @value(0)
    ipc-rmid,
    /// @value(1)
    ipc-set,
    /// @value(2)
    /// No C assert: musl ORs `IPC_TIME64` (0x100) into `IPC_STAT` on time64 archs and translates.
    /// @c-skip
    ipc-stat,
    /// @value(3)
    ipc-info,
    /// @value(11)
    getpid,
    /// @value(11)
    /// No C assert: musl ORs `IPC_TIME64` (0x100) into `MSG_STAT` on time64 archs and translates.
    /// @c-skip
    msg-stat,
    /// @value(11)
    shm-lock,
    /// @value(12)
    getval,
    /// @value(12)
    msg-info,
    /// @value(12)
    shm-unlock,
    /// @value(13)
    getall,
    /// @value(13)
    /// No C assert: musl ORs `IPC_TIME64` (0x100) into `SHM_STAT` on time64 archs and translates.
    /// @c-skip
    shm-stat,
    /// @value(14)
    getncnt,
    /// @value(14)
    shm-info,
    /// @value(15)
    getzcnt,
    /// @value(16)
    setval,
    /// @value(17)
    setall,
    /// @value(18)
    /// No C assert: musl ORs `IPC_TIME64` (0x100) into `SEM_STAT` on time64 archs and translates.
    /// @c-skip
    sem-stat,
    /// @value(19)
    sem-info,
    /// @value(256)
    /// No C assert: musl's internal `IPC_64` is 0 on riscv32 and wasm32; asm-generic kernels
    /// always use the 64-bit IPC structs, so musl passes no flag.
    /// @c-skip
    ipc-64,
  }

  /// `msgrcv` flags (`linux/msg.h`).
  /// @repr(u32)
  /// @c(int)
  flags msgrcv-flags {
    /// @value(0x1000)
    msg-noerror,
    /// @value(0x2000)
    msg-except,
    /// @value(0x4000)
    msg-copy,
  }

  /// `sembuf.sem_flg` bits (`linux/sem.h`).
  /// @repr(u32)
  flags sem-flags {
    /// @value(0x1000)
    sem-undo,
  }

  /// `shmget`/`shmat` flags (`linux/shm.h`).
  /// @repr(u32)
  /// @c(int)
  flags shm-flags {
    /// @value(0x80)
    shm-w,
    /// @value(0x100)
    shm-r,
    /// @value(0x800)
    shm-hugetlb,
    /// @value(0x1000)
    shm-noreserve,
    /// @value(0x1000)
    shm-rdonly,
    /// @value(0x2000)
    shm-rnd,
    /// @value(0x4000)
    shm-remap,
    /// @value(0x8000)
    shm-exec,
  }

  // ==== Asynchronous I/O and io_uring ====

  /// Linux native AIO control block (`struct iocb`). Pointers are zero-extended `u64`s.
  /// @kernel-only
  /// @size(64)
  /// @align(8)
  record iocb {
    aio-data: u64,
    aio-key: u32,
    aio-rw-flags: rwf,
    aio-lio-opcode: u16,
    aio-reqprio: s16,
    aio-fildes: u32,
    aio-buf: u64,
    aio-nbytes: u64,
    aio-offset: s64,
    aio-reserved2: u64,
    aio-flags: u32,
    aio-resfd: u32,
  }

  /// Linux native AIO completion (`struct io_event`).
  /// @kernel-only
  /// @size(32)
  /// @align(8)
  record io-event {
    data: u64,
    obj: u64,
    res: s64,
    res2: s64,
  }

  /// 6th argument of `io_pgetevents_time64` (`struct __aio_sigset`).
  /// @kernel-only
  /// @size(8)
  /// @align(4)
  record aio-sigset {
    sigmask: const-sigset-ptr,
    sigsetsize: usize,
  }

  /// Submission ring offsets (`struct io_sqring_offsets`).
  /// @kernel-only
  /// @size(40)
  /// @align(8)
  record io-sqring-offsets {
    head: u32,
    tail: u32,
    ring-mask: u32,
    ring-entries: u32,
    %flags: u32,
    dropped: u32,
    array: u32,
    resv1: u32,
    user-addr: u64,
  }

  /// Completion ring offsets (`struct io_cqring_offsets`).
  /// @kernel-only
  /// @size(40)
  /// @align(8)
  record io-cqring-offsets {
    head: u32,
    tail: u32,
    ring-mask: u32,
    ring-entries: u32,
    overflow: u32,
    cqes: u32,
    %flags: u32,
    resv1: u32,
    user-addr: u64,
  }

  /// `io_uring_setup` parameters (`struct io_uring_params`).
  /// @kernel-only
  /// @size(120)
  /// @align(8)
  record io-uring-params {
    sq-entries: u32,
    cq-entries: u32,
    %flags: u32,
    sq-thread-cpu: u32,
    sq-thread-idle: u32,
    features: u32,
    wq-fd: u32,
    resv: list<u32, 3>,
    sq-off: io-sqring-offsets,
    cq-off: io-cqring-offsets,
  }

  /// `io_uring_enter` extended argument with `IORING_ENTER_EXT_ARG` (`struct io_uring_getevents_arg`).
  /// @kernel-only
  /// @size(24)
  /// @align(8)
  record io-uring-getevents-arg {
    sigmask: u64,
    sigmask-sz: u32,
    min-wait-usec: u32,
    ts: u64,
  }

  // ==== Linux AIO rings, io_uring submissions and completions, rseq ====

  /// `iocb.aio_lio_opcode` (`IOCB_CMD_*`, `linux/aio_abi.h`).
  /// @repr(u16)
  enum iocb-cmd {
    /// @value(0)
    iocb-cmd-pread,
    /// @value(1)
    iocb-cmd-pwrite,
    /// @value(2)
    iocb-cmd-fsync,
    /// @value(3)
    iocb-cmd-fdsync,
    /// @value(5)
    iocb-cmd-poll,
    /// @value(6)
    iocb-cmd-noop,
    /// @value(7)
    iocb-cmd-preadv,
    /// @value(8)
    iocb-cmd-pwritev,
  }

  /// `iocb.aio_flags` (`IOCB_FLAG_*`, `linux/aio_abi.h`).
  /// @repr(u32)
  flags iocb-flags {
    /// `aio_resfd` names an eventfd that every completion signals.
    /// @value(0x1)
    iocb-flag-resfd,
    /// `aio_reqprio` is an I/O priority.
    /// @value(0x2)
    iocb-flag-ioprio,
  }

  /// The header of a Linux AIO context's completion ring, which `io_setup` maps into the
  /// caller's memory at the context's address (`struct aio_ring`, `fs/aio.c`; kernel-internal,
  /// but libaio reads it). The `io-event`s follow it.
  /// @kernel-only
  /// @size(32)
  /// @align(4)
  record aio-ring {
    /// The context's index in the process's table (`kioctx::id`).
    id: u32,
    /// How many events the ring holds.
    nr: u32,
    /// The next event to read; userspace may move it.
    head: u32,
    /// Where the next completion goes.
    tail: u32,
    magic: u32,
    compat-features: u32,
    incompat-features: u32,
    /// The size of this header.
    header-length: u32,
  }

  /// Constants of the AIO ring (`fs/aio.c`).
  /// @repr(u32)
  enum aio-ring-misc {
    /// @value(0x0)
    aio-ring-incompat-features,
    /// @value(0x1)
    aio-ring-compat-features,
    /// @value(0xa10a10a1)
    aio-ring-magic,
  }

  /// One submission queue entry (`struct io_uring_sqe`). Most fields are unions named by the
  /// operation; their common names are used here.
  /// @kernel-only
  /// @size(64)
  /// @align(8)
  record io-uring-sqe {
    opcode: u8,
    %flags: u8,
    ioprio: u16,
    fd: s32,
    /// `off`, `addr2` or `cmd_op`.
    off: u64,
    /// `addr`, `splice_off_in` or `level`/`optname`.
    addr: u64,
    len: u32,
    /// `rw_flags`, `fsync_flags`, `poll32_events`, `msg_flags`, `timeout_flags`,
    /// `accept_flags`, `cancel_flags`, `open_flags`, `statx_flags` and the other per-operation
    /// flags.
    op-flags: u32,
    user-data: u64,
    /// `buf_index` or `buf_group`.
    buf-index: u16,
    personality: u16,
    /// `splice_fd_in`, `file_index`, `optlen` or `addr_len`.
    splice-fd-in: s32,
    addr3: u64,
    /// @c-name(__pad2)
    pad2: u64,
  }

  /// One completion queue entry (`struct io_uring_cqe`).
  /// @kernel-only
  /// @size(16)
  /// @align(8)
  record io-uring-cqe {
    user-data: u64,
    res: s32,
    %flags: u32,
  }

  /// `io_uring_sqe.opcode` (`enum io_uring_op`).
  /// @repr(u8)
  enum io-uring-op {
    /// @value(0)
    ioring-op-nop,
    /// @value(1)
    ioring-op-readv,
    /// @value(2)
    ioring-op-writev,
    /// @value(3)
    ioring-op-fsync,
    /// @value(4)
    ioring-op-read-fixed,
    /// @value(5)
    ioring-op-write-fixed,
    /// @value(6)
    ioring-op-poll-add,
    /// @value(7)
    ioring-op-poll-remove,
    /// @value(8)
    ioring-op-sync-file-range,
    /// @value(9)
    ioring-op-sendmsg,
    /// @value(10)
    ioring-op-recvmsg,
    /// @value(11)
    ioring-op-timeout,
    /// @value(12)
    ioring-op-timeout-remove,
    /// @value(13)
    ioring-op-accept,
    /// @value(14)
    ioring-op-async-cancel,
    /// @value(15)
    ioring-op-link-timeout,
    /// @value(16)
    ioring-op-connect,
    /// @value(17)
    ioring-op-fallocate,
    /// @value(18)
    ioring-op-openat,
    /// @value(19)
    ioring-op-close,
    /// @value(20)
    ioring-op-files-update,
    /// @value(21)
    ioring-op-statx,
    /// @value(22)
    ioring-op-read,
    /// @value(23)
    ioring-op-write,
    /// @value(24)
    ioring-op-fadvise,
    /// @value(25)
    ioring-op-madvise,
    /// @value(26)
    ioring-op-send,
    /// @value(27)
    ioring-op-recv,
    /// @value(28)
    ioring-op-openat2,
    /// @value(29)
    ioring-op-epoll-ctl,
    /// @value(30)
    ioring-op-splice,
    /// @value(31)
    ioring-op-provide-buffers,
    /// @value(32)
    ioring-op-remove-buffers,
    /// @value(33)
    ioring-op-tee,
    /// @value(34)
    ioring-op-shutdown,
    /// @value(35)
    ioring-op-renameat,
    /// @value(36)
    ioring-op-unlinkat,
    /// @value(37)
    ioring-op-mkdirat,
    /// @value(38)
    ioring-op-symlinkat,
    /// @value(39)
    ioring-op-linkat,
    /// @value(40)
    ioring-op-msg-ring,
    /// @value(41)
    ioring-op-fsetxattr,
    /// @value(42)
    ioring-op-setxattr,
    /// @value(43)
    ioring-op-fgetxattr,
    /// @value(44)
    ioring-op-getxattr,
    /// @value(45)
    ioring-op-socket,
    /// @value(46)
    ioring-op-uring-cmd,
    /// @value(47)
    ioring-op-send-zc,
    /// @value(48)
    ioring-op-sendmsg-zc,
    /// @value(49)
    ioring-op-read-multishot,
    /// @value(50)
    ioring-op-waitid,
    /// @value(51)
    ioring-op-futex-wait,
    /// @value(52)
    ioring-op-futex-wake,
    /// @value(53)
    ioring-op-futex-waitv,
    /// @value(54)
    ioring-op-fixed-fd-install,
    /// @value(55)
    ioring-op-ftruncate,
    /// @value(56)
    ioring-op-bind,
    /// @value(57)
    ioring-op-listen,
    /// @value(58)
    ioring-op-recv-zc,
    /// @value(59)
    ioring-op-epoll-wait,
    /// @value(60)
    ioring-op-readv-fixed,
    /// @value(61)
    ioring-op-writev-fixed,
    /// @value(62)
    ioring-op-pipe,
    /// @value(63)
    ioring-op-nop128,
    /// @value(64)
    ioring-op-uring-cmd128,
    /// @value(65)
    ioring-op-last,
  }

  /// `io_uring_sqe.flags` (`IOSQE_*`).
  /// @repr(u8)
  flags iosqe-flags {
    /// @value(0x1)
    iosqe-fixed-file,
    /// @value(0x2)
    iosqe-io-drain,
    /// @value(0x4)
    iosqe-io-link,
    /// @value(0x8)
    iosqe-io-hardlink,
    /// @value(0x10)
    iosqe-async,
    /// @value(0x20)
    iosqe-buffer-select,
    /// @value(0x40)
    iosqe-cqe-skip-success,
  }

  /// `io_uring_params.flags` (`IORING_SETUP_*`).
  /// @repr(u32)
  flags ioring-setup-flags {
    /// @value(0x1)
    ioring-setup-iopoll,
    /// @value(0x2)
    ioring-setup-sqpoll,
    /// @value(0x4)
    ioring-setup-sq-aff,
    /// @value(0x8)
    ioring-setup-cqsize,
    /// @value(0x10)
    ioring-setup-clamp,
    /// @value(0x20)
    ioring-setup-attach-wq,
    /// @value(0x40)
    ioring-setup-r-disabled,
    /// @value(0x80)
    ioring-setup-submit-all,
    /// @value(0x100)
    ioring-setup-coop-taskrun,
    /// @value(0x200)
    ioring-setup-taskrun-flag,
    /// @value(0x400)
    ioring-setup-sqe128,
    /// @value(0x800)
    ioring-setup-cqe32,
    /// @value(0x1000)
    ioring-setup-single-issuer,
    /// @value(0x2000)
    ioring-setup-defer-taskrun,
    /// @value(0x4000)
    ioring-setup-no-mmap,
    /// @value(0x8000)
    ioring-setup-registered-fd-only,
    /// @value(0x10000)
    ioring-setup-no-sqarray,
    /// @value(0x20000)
    ioring-setup-hybrid-iopoll,
    /// @value(0x40000)
    ioring-setup-cqe-mixed,
    /// @value(0x80000)
    ioring-setup-sqe-mixed,
    /// @value(0x100000)
    ioring-setup-sq-rewind,
  }

  /// `io_uring_params.features` (`IORING_FEAT_*`).
  /// @repr(u32)
  flags ioring-feat-flags {
    /// @value(0x1)
    ioring-feat-single-mmap,
    /// @value(0x2)
    ioring-feat-nodrop,
    /// @value(0x4)
    ioring-feat-submit-stable,
    /// @value(0x8)
    ioring-feat-rw-cur-pos,
    /// @value(0x10)
    ioring-feat-cur-personality,
    /// @value(0x20)
    ioring-feat-fast-poll,
    /// @value(0x40)
    ioring-feat-poll-32bits,
    /// @value(0x80)
    ioring-feat-sqpoll-nonfixed,
    /// @value(0x100)
    ioring-feat-ext-arg,
    /// @value(0x200)
    ioring-feat-native-workers,
    /// @value(0x400)
    ioring-feat-rsrc-tags,
    /// @value(0x800)
    ioring-feat-cqe-skip,
    /// @value(0x1000)
    ioring-feat-linked-file,
    /// @value(0x2000)
    ioring-feat-reg-reg-ring,
    /// @value(0x4000)
    ioring-feat-recvsend-bundle,
    /// @value(0x8000)
    ioring-feat-min-timeout,
    /// @value(0x10000)
    ioring-feat-rw-attr,
    /// @value(0x20000)
    ioring-feat-no-iowait,
  }

  /// `io_uring_enter` flags (`IORING_ENTER_*`).
  /// @repr(u32)
  flags ioring-enter-flags {
    /// @value(0x1)
    ioring-enter-getevents,
    /// @value(0x2)
    ioring-enter-sq-wakeup,
    /// @value(0x4)
    ioring-enter-sq-wait,
    /// @value(0x8)
    ioring-enter-ext-arg,
    /// @value(0x10)
    ioring-enter-registered-ring,
    /// @value(0x20)
    ioring-enter-abs-timer,
    /// @value(0x40)
    ioring-enter-ext-arg-reg,
    /// @value(0x80)
    ioring-enter-no-iowait,
  }

  /// The submission ring's flags word (`IORING_SQ_*`).
  /// @repr(u32)
  flags ioring-sq-flags {
    /// @value(0x1)
    ioring-sq-need-wakeup,
    /// @value(0x2)
    ioring-sq-cq-overflow,
    /// @value(0x4)
    ioring-sq-taskrun,
  }

  /// The completion ring's flags word (`IORING_CQ_*`).
  /// @repr(u32)
  flags ioring-cq-flags {
    /// @value(0x1)
    ioring-cq-eventfd-disabled,
  }

  /// `io_uring_cqe.flags` (`IORING_CQE_F_*`). The selected buffer's id is in the bits above
  /// `IORING_CQE_BUFFER_SHIFT`.
  /// @repr(u32)
  flags ioring-cqe-flags {
    /// @value(0x1)
    ioring-cqe-f-buffer,
    /// @value(0x2)
    ioring-cqe-f-more,
    /// @value(0x4)
    ioring-cqe-f-sock-nonempty,
    /// @value(0x8)
    ioring-cqe-f-notif,
    /// @value(0x10)
    ioring-cqe-f-buf-more,
    /// @value(0x20)
    ioring-cqe-f-skip,
    /// @value(0x8000)
    ioring-cqe-f-32,
  }

  /// Per-operation flags of `io_uring_sqe` (`IORING_FSYNC_*`, `IORING_TIMEOUT_*`,
  /// `IORING_POLL_*`, `IORING_ASYNC_CANCEL_*`, `IORING_RECVSEND_*`, `IORING_ACCEPT_*`,
  /// `IORING_NOP_*`). Families share bits; each operation reads its own.
  /// @repr(u32)
  flags ioring-op-flags {
    /// @value(0x1)
    ioring-fsync-datasync,
    /// @value(0x1)
    ioring-timeout-abs,
    /// @value(0x2)
    ioring-timeout-update,
    /// @value(0x4)
    ioring-timeout-boottime,
    /// @value(0x8)
    ioring-timeout-realtime,
    /// @value(0x10)
    ioring-link-timeout-update,
    /// @value(0x20)
    ioring-timeout-etime-success,
    /// @value(0x40)
    ioring-timeout-multishot,
    /// @value(0x80)
    ioring-timeout-immediate-arg,
    /// @value(0xc)
    ioring-timeout-clock-mask,
    /// @value(0x12)
    ioring-timeout-update-mask,
    /// @value(0x1)
    ioring-poll-add-multi,
    /// @value(0x2)
    ioring-poll-update-events,
    /// @value(0x4)
    ioring-poll-update-user-data,
    /// @value(0x8)
    ioring-poll-add-level,
    /// @value(0x1)
    ioring-async-cancel-all,
    /// @value(0x2)
    ioring-async-cancel-fd,
    /// @value(0x4)
    ioring-async-cancel-any,
    /// @value(0x8)
    ioring-async-cancel-fd-fixed,
    /// @value(0x10)
    ioring-async-cancel-userdata,
    /// @value(0x20)
    ioring-async-cancel-op,
    /// @value(0x1)
    ioring-recvsend-poll-first,
    /// @value(0x2)
    ioring-recv-multishot,
    /// @value(0x4)
    ioring-recvsend-fixed-buf,
    /// @value(0x8)
    ioring-send-zc-report-usage,
    /// @value(0x10)
    ioring-recvsend-bundle,
    /// @value(0x20)
    ioring-send-vectorized,
    /// @value(0x1)
    ioring-accept-multishot,
    /// @value(0x2)
    ioring-accept-dontwait,
    /// @value(0x4)
    ioring-accept-poll-first,
    /// @value(0x1)
    ioring-nop-inject-result,
    /// @value(0x2)
    ioring-nop-file,
    /// @value(0x4)
    ioring-nop-fixed-file,
    /// @value(0x8)
    ioring-nop-fixed-buffer,
    /// @value(0x10)
    ioring-nop-tw,
    /// @value(0x20)
    ioring-nop-cqe32,
  }

  /// `io_uring_register` operations (`enum io_uring_register_op`).
  /// @repr(u32)
  enum io-uring-register-op {
    /// @value(0)
    ioring-register-buffers,
    /// @value(1)
    ioring-unregister-buffers,
    /// @value(2)
    ioring-register-files,
    /// @value(3)
    ioring-unregister-files,
    /// @value(4)
    ioring-register-eventfd,
    /// @value(5)
    ioring-unregister-eventfd,
    /// @value(6)
    ioring-register-files-update,
    /// @value(7)
    ioring-register-eventfd-async,
    /// @value(8)
    ioring-register-probe,
    /// @value(9)
    ioring-register-personality,
    /// @value(10)
    ioring-unregister-personality,
    /// @value(11)
    ioring-register-restrictions,
    /// @value(12)
    ioring-register-enable-rings,
    /// @value(13)
    ioring-register-files2,
    /// @value(14)
    ioring-register-files-update2,
    /// @value(15)
    ioring-register-buffers2,
    /// @value(16)
    ioring-register-buffers-update,
    /// @value(17)
    ioring-register-iowq-aff,
    /// @value(18)
    ioring-unregister-iowq-aff,
    /// @value(19)
    ioring-register-iowq-max-workers,
    /// @value(20)
    ioring-register-ring-fds,
    /// @value(21)
    ioring-unregister-ring-fds,
    /// @value(22)
    ioring-register-pbuf-ring,
    /// @value(23)
    ioring-unregister-pbuf-ring,
    /// @value(24)
    ioring-register-sync-cancel,
    /// @value(25)
    ioring-register-file-alloc-range,
    /// @value(26)
    ioring-register-pbuf-status,
    /// @value(27)
    ioring-register-napi,
    /// @value(28)
    ioring-unregister-napi,
    /// @value(29)
    ioring-register-clock,
    /// @value(30)
    ioring-register-clone-buffers,
    /// @value(31)
    ioring-register-send-msg-ring,
    /// @value(32)
    ioring-register-zcrx-ifq,
    /// @value(33)
    ioring-register-resize-rings,
    /// @value(34)
    ioring-register-mem-region,
    /// @value(35)
    ioring-register-query,
    /// @value(36)
    ioring-register-zcrx-ctrl,
    /// @value(37)
    ioring-register-bpf-filter,
    /// @value(38)
    ioring-register-last,
    /// @value(0x80000000)
    ioring-register-use-registered-ring,
  }

  /// Other io_uring constants: the `mmap` offsets of the rings (`IORING_OFF_*`), the buffer id
  /// shift of a completion, `IORING_FILE_INDEX_ALLOC`, `IORING_REGISTER_FILES_SKIP` and the
  /// probe's `IO_URING_OP_SUPPORTED`.
  /// @repr(s64)
  enum io-uring-misc {
    /// @value(0x0)
    ioring-off-sq-ring,
    /// @value(0x8000000)
    ioring-off-cq-ring,
    /// @value(0x10000000)
    ioring-off-sqes,
    /// @value(0x80000000)
    ioring-off-pbuf-ring,
    /// @value(16)
    ioring-off-pbuf-shift,
    /// @value(0xf8000000)
    ioring-off-mmap-mask,
    /// @value(16)
    ioring-cqe-buffer-shift,
    /// @value(0xffffffff)
    ioring-file-index-alloc,
    /// @value(-2)
    ioring-register-files-skip,
    /// @value(0x1)
    io-uring-op-supported,
    /// @value(0x1)
    ioring-rsrc-register-sparse,
  }

  /// `IORING_REGISTER_FILES_UPDATE` argument (`struct io_uring_files_update`).
  /// @kernel-only
  /// @size(16)
  /// @align(8)
  record io-uring-files-update {
    offset: u32,
    resv: u32,
    /// Guest address of the `s32` descriptors, zero-extended.
    fds: u64,
  }

  /// `IORING_REGISTER_FILES2`/`BUFFERS2` argument (`struct io_uring_rsrc_register`).
  /// @kernel-only
  /// @size(32)
  /// @align(8)
  record io-uring-rsrc-register {
    nr: u32,
    %flags: u32,
    resv2: u64,
    data: u64,
    tags: u64,
  }

  /// `IORING_REGISTER_FILES_UPDATE2`/`BUFFERS_UPDATE` argument (`struct io_uring_rsrc_update2`).
  /// @kernel-only
  /// @size(32)
  /// @align(8)
  record io-uring-rsrc-update2 {
    offset: u32,
    resv: u32,
    data: u64,
    tags: u64,
    nr: u32,
    resv2: u32,
  }

  /// The header of `IORING_REGISTER_PROBE`'s result (`struct io_uring_probe`); `ops_len`
  /// `io-uring-probe-op`s follow it.
  /// @kernel-only
  /// @size(16)
  /// @align(4)
  record io-uring-probe {
    last-op: u8,
    ops-len: u8,
    resv: u16,
    resv2: list<u32, 3>,
  }

  /// One operation of `IORING_REGISTER_PROBE`'s result (`struct io_uring_probe_op`).
  /// @kernel-only
  /// @size(8)
  /// @align(4)
  record io-uring-probe-op {
    op: u8,
    resv: u8,
    %flags: u16,
    resv2: u32,
  }

  /// One buffer of a provided buffer ring (`struct io_uring_buf`). The ring's tail overlays
  /// the `resv` of its first entry (`struct io_uring_buf_ring`).
  /// @kernel-only
  /// @size(16)
  /// @align(8)
  record io-uring-buf {
    addr: u64,
    len: u32,
    bid: u16,
    resv: u16,
  }

  /// `IORING_(UN)REGISTER_PBUF_RING` argument (`struct io_uring_buf_reg`).
  /// @kernel-only
  /// @size(40)
  /// @align(8)
  record io-uring-buf-reg {
    ring-addr: u64,
    ring-entries: u32,
    bgid: u16,
    %flags: u16,
    min-left: u32,
    resv: list<u32, 5>,
  }

  /// `IORING_REGISTER_PBUF_STATUS` argument (`struct io_uring_buf_status`).
  /// @kernel-only
  /// @size(40)
  /// @align(4)
  record io-uring-buf-status {
    buf-group: u32,
    head: u32,
    resv: list<u32, 8>,
  }

  /// `io_uring_buf_reg.flags` (`enum io_uring_register_pbuf_ring_flags`).
  /// @repr(u16)
  flags iou-pbuf-ring-flags {
    /// The kernel allocates the ring, which the application maps at
    /// `IORING_OFF_PBUF_RING | bgid << IORING_OFF_PBUF_SHIFT`.
    /// @value(0x1)
    iou-pbuf-ring-mmap,
    /// Buffers are consumed incrementally.
    /// @value(0x2)
    iou-pbuf-ring-inc,
  }

  /// `IORING_REGISTER_RING_FDS` and `IORING_UNREGISTER_RING_FDS` argument
  /// (`struct io_uring_rsrc_update`).
  /// @kernel-only
  /// @size(16)
  /// @align(8)
  record io-uring-rsrc-update {
    offset: u32,
    resv: u32,
    data: u64,
  }

  /// `IORING_REGISTER_FILE_ALLOC_RANGE` argument (`struct io_uring_file_index_range`): the
  /// slots `[off, off + len)`.
  /// @kernel-only
  /// @size(16)
  /// @align(8)
  record io-uring-file-index-range {
    off: u32,
    len: u32,
    resv: u64,
  }

  /// The header a multishot `IORING_OP_RECVMSG` writes at the start of each provided buffer
  /// (`struct io_uring_recvmsg_out`); the name, the control data and the payload follow it.
  /// @kernel-only
  /// @size(16)
  /// @align(4)
  record io-uring-recvmsg-out {
    namelen: u32,
    controllen: u32,
    payloadlen: u32,
    %flags: u32,
  }

  /// `IORING_OP_MSG_RING` commands, in `sqe->addr` (`enum io_uring_msg_ring_flags`).
  /// @repr(u32)
  enum io-uring-msg-ring-cmd {
    /// Post `len` as the result and `off` as the user data on the target ring.
    /// @value(0)
    ioring-msg-data,
    /// Install a registered file in the target ring's table.
    /// @value(1)
    ioring-msg-send-fd,
  }

  /// `IORING_OP_MSG_RING` flags (`sqe->msg_ring_flags`).
  /// @repr(u32)
  flags ioring-msg-ring-flags {
    /// @value(0x1)
    ioring-msg-ring-cqe-skip,
    /// The target's CQE takes its flags from `sqe->file_index`.
    /// @value(0x2)
    ioring-msg-ring-flags-pass,
  }

  /// `IORING_OP_FIXED_FD_INSTALL` flags (`sqe->install_fd_flags`).
  /// @repr(u32)
  flags ioring-fixed-fd-flags {
    /// @value(0x1)
    ioring-fixed-fd-no-cloexec,
  }

  /// `IORING_OP_URING_CMD` commands on a socket (`enum io_uring_socket_op`).
  /// @repr(u32)
  enum io-uring-socket-op {
    /// @value(0)
    socket-uring-op-siocinq,
    /// @value(1)
    socket-uring-op-siocoutq,
    /// @value(2)
    socket-uring-op-getsockopt,
    /// @value(3)
    socket-uring-op-setsockopt,
    /// @value(4)
    socket-uring-op-tx-timestamp,
    /// @value(5)
    socket-uring-op-getsockname,
  }

  /// More io_uring constants: `IORING_NOTIF_USAGE_ZC_COPIED` (a zero-copy send's
  /// notification result), `SPLICE_F_FD_IN_FIXED` (`splice_flags`: `splice_fd_in` is a
  /// registered file) and the `IORING_URING_CMD_*` flags (`sqe->uring_cmd_flags`).
  /// @repr(u32)
  enum io-uring-misc2 {
    /// @value(0x80000000)
    ioring-notif-usage-zc-copied,
    /// @value(0x80000000)
    splice-f-fd-in-fixed,
    /// @value(0x1)
    ioring-uring-cmd-fixed,
    /// @value(0x2)
    ioring-uring-cmd-multishot,
  }

  /// `rseq` flags (`enum rseq_flags`, `linux/rseq.h`).
  /// @repr(s32)
  /// @c(int)
  flags rseq-flags {
    /// @value(0x1)
    rseq-flag-unregister,
    /// @value(0x2)
    rseq-flag-slice-ext-default-on,
  }

  /// `struct rseq.cpu_id` values before or without a registration (`enum rseq_cpu_id_state`),
  /// and the sizes the auxiliary vector reports (`AT_RSEQ_FEATURE_SIZE`, `AT_RSEQ_ALIGN`).
  /// @repr(s32)
  enum rseq-misc {
    /// @value(-1)
    rseq-cpu-id-uninitialized,
    /// @value(-2)
    rseq-cpu-id-registration-failed,
    /// The size of the area before `struct rseq` became extensible (`ORIG_RSEQ_SIZE`, `kernel/rseq.c`).
    /// @value(32)
    orig-rseq-size,
  }

  /// `struct rseq.flags` and `struct rseq_cs.flags` (`enum rseq_cs_flags`).
  /// @repr(u32)
  flags rseq-cs-flags {
    /// @value(0x1)
    rseq-cs-flag-no-restart-on-preempt,
    /// @value(0x2)
    rseq-cs-flag-no-restart-on-signal,
    /// @value(0x4)
    rseq-cs-flag-no-restart-on-migrate,
    /// @value(0x10)
    rseq-cs-flag-slice-ext-available,
    /// @value(0x20)
    rseq-cs-flag-slice-ext-enabled,
  }

  /// A thread's restartable sequences area (`struct rseq`, `linux/rseq.h`), up to its feature
  /// end. Linux aligns it to 32 bytes, which WIT cannot express; the layout is the same.
  /// @kernel-only
  /// @size(40)
  /// @align(8)
  record rseq {
    cpu-id-start: u32,
    cpu-id: u32,
    /// Guest address of the active `struct rseq_cs`, zero-extended.
    rseq-cs: u64,
    %flags: u32,
    node-id: u32,
    mm-cid: u32,
    /// `struct rseq_slice_ctrl`.
    slice-ctrl: u32,
    /// @c-name(__reserved)
    reserved: u8,
  }

  // ==== Terminals and ioctl requests ====

  /// Kernel terminal attributes for `TCGETS`/`TCSETS*` (asm-generic `struct termios`, `NCCS` 19).
  /// musl's 60-byte `struct termios` is a prefix-compatible superset passed directly.
  /// @kernel-only
  /// @size(36)
  /// @align(4)
  record termios {
    c-iflag: termios-iflag,
    c-oflag: termios-oflag,
    c-cflag: termios-cflag,
    c-lflag: termios-lflag,
    c-line: u8,
    c-cc: list<u8, 19>,
  }

  /// Terminal attributes with explicit speeds for `TCGETS2`/`TCSETS*2` (`struct termios2`).
  /// @kernel-only
  /// @size(44)
  /// @align(4)
  record termios2 {
    c-iflag: termios-iflag,
    c-oflag: termios-oflag,
    c-cflag: termios-cflag,
    c-lflag: termios-lflag,
    c-line: u8,
    c-cc: list<u8, 19>,
    c-ispeed: u32,
    c-ospeed: u32,
  }

  /// Terminal window size for `TIOCGWINSZ`/`TIOCSWINSZ` (`struct winsize`).
  /// @c(struct winsize)
  /// @size(8)
  /// @align(2)
  record winsize {
    ws-row: u16,
    ws-col: u16,
    ws-xpixel: u16,
    ws-ypixel: u16,
  }

