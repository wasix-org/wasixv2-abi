    keyctl-set-timeout,
    /// @value(16)
    keyctl-assume-authority,
    /// @value(17)
    keyctl-get-security,
    /// @value(18)
    keyctl-session-to-parent,
    /// @value(19)
    keyctl-reject,
    /// @value(20)
    keyctl-instantiate-iov,
    /// @value(21)
    keyctl-invalidate,
    /// @value(22)
    keyctl-get-persistent,
    /// @value(23)
    keyctl-dh-compute,
    /// @value(24)
    keyctl-pkey-query,
    /// @value(25)
    keyctl-pkey-encrypt,
    /// @value(26)
    keyctl-pkey-decrypt,
    /// @value(27)
    keyctl-pkey-sign,
    /// @value(28)
