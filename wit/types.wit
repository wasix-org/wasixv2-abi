  // ==== Mounting ====

  /// `mount_setattr`/`open_tree_attr` attributes (`struct mount_attr`).
  /// @kernel-only
  /// @size(32)
  /// @align(8)
  record mount-attr {
    attr-set: mount-attr-flags,
    attr-clr: mount-attr-flags,
    propagation: u64,
    userns-fd: u64,
  }

  /// `statmount`/`listmount` request (`struct mnt_id_req`). `mnt-ns-fd` is a union with `mnt_fd`.
  /// @kernel-only
  /// @size(32)
  /// @align(8)
  record mnt-id-req {
    size: u32,
    mnt-ns-fd: u32,
    mnt-id: u64,
    param: u64,
    mnt-ns-id: u64,
  }

  /// The fixed part of `statmount`'s result (`struct statmount`, UAPI `linux/mount.h`). The
  /// strings follow it in the caller's buffer (`str[]`); each `[str]` field is the offset of its
  /// NUL-terminated string from there. `size` is the whole result, strings included. `mask`
  /// says which fields were filled (`statmount-mask`).
  /// @kernel-only
  /// @size(512)
  /// @align(8)
  record statmount {
    size: u32,
    /// [str] The mount's and the superblock's options, comma separated (`STATMOUNT_MNT_OPTS`).
    mnt-opts: u32,
    mask: u64,
    sb-dev-major: u32,
    sb-dev-minor: u32,
    sb-magic: u64,
    /// `SB_RDONLY`, `SB_SYNCHRONOUS`, `SB_DIRSYNC`, `SB_LAZYTIME`.
    sb-flags: u32,
    /// [str]
    fs-type: u32,
    /// The mount's unique id (`STATX_MNT_ID_UNIQUE`).
    mnt-id: u64,
    /// The parent's unique id; its own for a namespace root.
    mnt-parent-id: u64,
    /// The ids `/proc/<pid>/mountinfo` shows.
    mnt-id-old: u32,
    mnt-parent-id-old: u32,
    /// `MOUNT_ATTR_*`.
    mnt-attr: u64,
    /// `MS_SHARED`, `MS_SLAVE`, `MS_PRIVATE`, `MS_UNBINDABLE`.
    mnt-propagation: u64,
    mnt-peer-group: u64,
    mnt-master: u64,
    propagate-from: u64,
    /// [str] The mount's root, relative to its filesystem's root.
    mnt-root: u32,
    /// [str] The mountpoint, relative to the caller's root.
    mnt-point: u32,
    mnt-ns-id: u64,
    /// [str]
    fs-subtype: u32,
    /// [str]
    sb-source: u32,
    opt-num: u32,
    /// [str] `opt-num` NUL-terminated filesystem options.
    opt-array: u32,
    opt-sec-num: u32,
    /// [str]
    opt-sec-array: u32,
    supported-mask: u64,
    mnt-uidmap-num: u32,
    /// [str]
    mnt-uidmap: u32,
    mnt-gidmap-num: u32,
    /// [str]
    mnt-gidmap: u32,
    /// @c-name(__spare2)
    spare2: list<u64, 43>,
  }

  /// `listns` request (`struct ns_id_req`).
  /// @kernel-only
  /// @size(32)
  /// @align(8)
  record ns-id-req {
    size: u32,
    spare: u32,
    ns-id: u64,
    ns-type: u32,
    spare2: u32,
    user-ns-id: u64,
  }

