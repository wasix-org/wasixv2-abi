    /// @value(0x1)
    keyctl-caps1-ns-keyring-name,
    /// @value(0x2)
    keyctl-caps1-ns-key-tag,
    /// @value(0x4)
    keyctl-caps1-notifications,
  }

  /// Key permissions (`key_perm_t`, `linux/key.h`; keyutils' `KEY_POS_*` and friends): one byte
  /// each for the possessor, the owner, the group and others.
  /// @repr(u32)
  /// @c(unsigned)
  flags key-perm {
    /// @value(0x01000000)
    key-pos-view,
    /// @value(0x02000000)
    key-pos-read,
    /// @value(0x04000000)
    key-pos-write,
    /// @value(0x08000000)
    key-pos-search,
    /// @value(0x10000000)
    key-pos-link,
    /// @value(0x20000000)
    key-pos-setattr,
    /// @value(0x3f000000)
    key-pos-all,
    /// @value(0x00010000)
    key-usr-view,
    /// @value(0x00020000)
    key-usr-read,
    /// @value(0x00040000)
    key-usr-write,
    /// @value(0x00080000)
    key-usr-search,
    /// @value(0x00100000)
    key-usr-link,
    /// @value(0x00200000)
    key-usr-setattr,
    /// @value(0x003f0000)
    key-usr-all,
    /// @value(0x00000100)
    key-grp-view,
    /// @value(0x00000200)
    key-grp-read,
    /// @value(0x00000400)
    key-grp-write,
    /// @value(0x00000800)
    key-grp-search,
    /// @value(0x00001000)
    key-grp-link,
    /// @value(0x00002000)
    key-grp-setattr,
    /// @value(0x00003f00)
    key-grp-all,
    /// @value(0x00000001)
    key-oth-view,
    /// @value(0x00000002)
    key-oth-read,
    /// @value(0x00000004)
    key-oth-write,
    /// @value(0x00000008)
    key-oth-search,
    /// @value(0x00000010)
    key-oth-link,
    /// @value(0x00000020)
    key-oth-setattr,
    /// @value(0x0000003f)
    key-oth-all,
  }

  /// LSM ids (`LSM_ID_*`, `linux/lsm.h`).
  /// @repr(u64)
  enum lsm-id {
    /// @value(0)
    lsm-id-undef,
    /// @value(100)
    lsm-id-capability,
    /// @value(101)
    lsm-id-selinux,
    /// @value(102)
    lsm-id-smack,
    /// @value(103)
    lsm-id-tomoyo,
    /// @value(104)
    lsm-id-apparmor,
    /// @value(105)
    lsm-id-yama,
    /// @value(106)
    lsm-id-loadpin,
    /// @value(107)
    lsm-id-safesetid,
    /// @value(108)
    lsm-id-lockdown,
    /// @value(109)
    lsm-id-bpf,
    /// @value(110)
    lsm-id-landlock,
    /// @value(111)
    lsm-id-ima,
    /// @value(112)
    lsm-id-evm,
    /// @value(113)
    lsm-id-ipe,
  }

  /// LSM attributes (`LSM_ATTR_*`, `linux/lsm.h`).
  /// @repr(u32)
  /// @c(unsigned)
  enum lsm-attr {
    /// @value(0)
    lsm-attr-undef,
    /// @value(100)
    lsm-attr-current,
    /// @value(101)
    lsm-attr-exec,
    /// @value(102)
    lsm-attr-fscreate,
    /// @value(103)
    lsm-attr-keycreate,
    /// @value(104)
    lsm-attr-prev,
    /// @value(105)
    lsm-attr-sockcreate,
  }

  /// `lsm_get_self_attr` flags (`linux/lsm.h`).
  /// @repr(u32)
  /// @c(unsigned)
  flags lsm-flags {
    /// @value(0x1)
    lsm-flag-single,
  }

  // ==== Tracing and introspection: ptrace, kcmp, ioprio ====

  /// `PTRACE_GET_SYSCALL_INFO` at a syscall-entry stop (`linux/ptrace.h`).
  /// @kernel-only
  /// @size(56)
  /// @align(8)
  record ptrace-syscall-info-entry {
    nr: u64,
    args: list<u64, 6>,
  }

  /// `PTRACE_GET_SYSCALL_INFO` at a syscall-exit stop (`linux/ptrace.h`).
  /// @kernel-only
  /// @size(16)
  /// @align(8)
  record ptrace-syscall-info-exit {
    rval: s64,
    is-error: u8,
    reserved: list<u8, 7>,
  }

  /// `PTRACE_GET_SYSCALL_INFO` at a `PTRACE_EVENT_SECCOMP` stop (`linux/ptrace.h`).
  /// @kernel-only
  /// @size(64)
  /// @align(8)
  record ptrace-syscall-info-seccomp {
    nr: u64,
    args: list<u64, 6>,
    ret-data: u32,
    reserved2: u32,
  }

  /// What `ptrace_syscall_info` holds for its `op`.
  /// @kernel-only
  /// @union
  /// @size(64)
  /// @align(8)
  record ptrace-syscall-info-data {
    entry: ptrace-syscall-info-entry,
    exit: ptrace-syscall-info-exit,
    seccomp: ptrace-syscall-info-seccomp,
  }

  /// `PTRACE_GET_SYSCALL_INFO` result (`struct ptrace_syscall_info`). wasm has no program
  /// counter: `instruction-pointer` is 0, `stack-pointer` the shadow stack pointer.
  /// @kernel-only
  /// @size(88)
  /// @align(8)
  record ptrace-syscall-info {
    op: u8,
    reserved: u8,
    %flags: u16,
    arch: u32,
    instruction-pointer: u64,
    stack-pointer: u64,
    data: ptrace-syscall-info-data,
  }

  /// `PTRACE_PEEKSIGINFO` arguments (`struct ptrace_peeksiginfo_args`).
  /// @kernel-only
  /// @size(16)
  /// @align(8)
  record ptrace-peeksiginfo-args {
    off: u64,
    %flags: u32,
    nr: s32,
  }

  /// `PTRACE_SECCOMP_GET_METADATA` argument and result (`struct seccomp_metadata`): the
  /// filter's index, oldest first, in; its `SECCOMP_FILTER_FLAG_*` flags out.
  /// @kernel-only
  /// @size(16)
  /// @align(8)
  record seccomp-metadata {
    filter-off: u64,
    %flags: u64,
  }

  /// `PTRACE_GET_RSEQ_CONFIGURATION` result (`struct ptrace_rseq_configuration`).
  /// @kernel-only
  /// @size(24)
  /// @align(8)
  record ptrace-rseq-configuration {
    rseq-abi-pointer: u64,
    rseq-abi-size: u32,
    signature: u32,
    %flags: u32,
    pad: u32,
  }

  /// `kcmp` comparison types (`enum kcmp_type`, `linux/kcmp.h`).
  /// @repr(s32)
  /// @c(int)
  enum kcmp-type {
    /// @value(0)
    kcmp-file,
    /// @value(1)
    kcmp-vm,
    /// @value(2)
    kcmp-files,
    /// @value(3)
    kcmp-fs,
    /// @value(4)
    kcmp-sighand,
    /// @value(5)
    kcmp-io,
    /// @value(6)
    kcmp-sysvsem,
    /// @value(7)
    kcmp-epoll-tfd,
  }

  /// `KCMP_EPOLL_TFD` slot (`struct kcmp_epoll_slot`, `linux/kcmp.h`).
  /// @kernel-only
  /// @size(12)
  /// @align(4)
  record kcmp-epoll-slot {
    efd: u32,
    tfd: u32,
    toff: u32,
  }

  /// @ptr(const kcmp-epoll-slot)
  type const-kcmp-epoll-slot-ptr = uptr;

  /// I/O scheduling classes (`IOPRIO_CLASS_*`, `linux/ioprio.h`).
  /// @repr(s32)
  /// @c(int)
  enum ioprio-class {
    /// @value(0)
    ioprio-class-none,
    /// @value(1)
    ioprio-class-rt,
    /// @value(2)
    ioprio-class-be,
    /// @value(3)
    ioprio-class-idle,
    /// @value(7)
    ioprio-class-invalid,
  }

  /// `ioprio_get`/`ioprio_set` targets (`IOPRIO_WHO_*`, `linux/ioprio.h`).
  /// @repr(s32)
  /// @c(int)
  enum ioprio-who {
    /// @value(1)
    ioprio-who-process,
    /// @value(2)
    ioprio-who-pgrp,
    /// @value(3)
    ioprio-who-user,
  }

  // ==== Checkpointing (wasixv2 extensions) ====

  /// What `stack-save` records for `stack-restore` (v1's `__wasi_stack_snapshot_t` layout).
  /// Opaque to the guest: the host fills it in.
  /// @size(24)
  /// @align(8)
  record stack-snapshot {
    user: u64,
    hash-lower: u64,
    hash-upper: u64,
  }

  /// @ptr(mut stack-snapshot)
  type stack-snapshot-ptr = uptr;

  /// @ptr(const stack-snapshot)
  type const-stack-snapshot-ptr = uptr;
}
