    /// @value(6)
    key-reqkey-defl-group-keyring,
    /// @value(7)
    key-reqkey-defl-requestor-keyring,
  }

  /// `keyctl` operations (first argument; `linux/keyctl.h`).
  /// @repr(s32)
  /// @c(int)
  enum keyctl-op {
    /// @value(0)
    keyctl-get-keyring-id,
    /// @value(1)
    keyctl-join-session-keyring,
    /// @value(2)
    keyctl-update,
