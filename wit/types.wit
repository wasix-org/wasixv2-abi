    /// @value(0x0)
    at-statx-sync-as-stat,
    /// @value(0x100)
    at-symlink-nofollow,
    /// @value(0x200)
    at-eaccess,
    /// @value(0x200)
    at-removedir,
    /// @value(0x400)
    at-symlink-follow,
    /// @value(0x800)
    at-no-automount,
    /// @value(0x1000)
    at-empty-path,
    /// @value(0x2000)
    at-statx-force-sync,
    /// @value(0x4000)
    at-statx-dont-sync,
    /// @value(0x6000)
    at-statx-sync-type,
    /// @value(0x8000)
    at-recursive,
    /// @value(0x10000)
    at-execve-check,
  }

  /// `AT_HANDLE_*` flags for `name_to_handle_at` (`linux/fcntl.h`).
