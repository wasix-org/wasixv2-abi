    /// @value(29)
    keyctl-restrict-keyring,
    /// @value(30)
    keyctl-move,
    /// @value(31)
    keyctl-capabilities,
    /// @value(32)
    keyctl-watch-key,
  }

  /// `KEYCTL_MOVE` flags and `KEYCTL_CAPABILITIES` bits (`linux/keyctl.h`).
  /// @repr(u32)
  /// @c(unsigned)
  flags keyctl-flags {
    /// @value(0x1)
    keyctl-move-excl,
    /// @value(0x1)
    keyctl-caps0-capabilities,
    /// @value(0x2)
    keyctl-caps0-persistent-keyrings,
    /// @value(0x4)
    keyctl-caps0-diffie-hellman,
    /// @value(0x8)
