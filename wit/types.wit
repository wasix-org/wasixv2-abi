    fs-xflag-dax,
    /// @value(0x10000)
    fs-xflag-cowextsize,
    /// @value(0x20000)
    fs-xflag-verity,
    /// @value(0x40000)
    fs-xflag-casefold,
    /// @value(0x80000)
    fs-xflag-casenonpreserving,
    /// @value(0x80000000)
    fs-xflag-hasattr,
  }

  /// `file_getattr`/`file_setattr` sizes (`FILE_ATTR_SIZE_*`, `linux/fs.h`).
  /// @repr(u32)
  enum file-attr-size {
    /// @value(24)
    file-attr-size-ver0,
    /// @value(24)
    file-attr-size-latest,
  }

  /// Header of a POSIX ACL extended attribute value (`struct posix_acl_xattr_header`,
  /// `linux/posix_acl_xattr.h`), little-endian; `posix-acl-xattr-entry` records follow.
  /// @kernel-only
  /// @size(4)
  /// @align(4)
  record posix-acl-xattr-header {
    a-version: u32,
  }

  /// One entry of a POSIX ACL extended attribute (`struct posix_acl_xattr_entry`),
  /// little-endian.
  /// @kernel-only
  /// @size(8)
  /// @align(4)
  record posix-acl-xattr-entry {
    e-tag: u16,
    e-perm: u16,
    e-id: u32,
  }

  /// POSIX ACL tags, permissions and constants (`linux/posix_acl.h`,
  /// `linux/posix_acl_xattr.h`).
  /// @repr(s32)
  enum posix-acl-misc {
    /// @value(-1)
    acl-undefined-id,
    /// @value(0x1)
    acl-execute,
    /// @value(0x1)
    acl-user-obj,
    /// @value(0x2)
    acl-user,
    /// @value(0x2)
    acl-write,
    /// @value(0x2)
    posix-acl-xattr-version,
    /// @value(0x4)
    acl-group-obj,
    /// @value(0x4)
    acl-read,
    /// @value(0x8)
    acl-group,
    /// @value(0x10)
    acl-mask,
    /// @value(0x20)
    acl-other,
    /// @value(0x4000)
    acl-type-default,
    /// @value(0x8000)
    acl-type-access,
  }

  /// Quota limits and usage of one id (`struct if_dqblk`, `linux/quota.h`).
  /// @kernel-only
  /// @size(72)
  /// @align(8)
  record if-dqblk {
    dqb-bhardlimit: u64,
    dqb-bsoftlimit: u64,
    dqb-curspace: u64,
    dqb-ihardlimit: u64,
    dqb-isoftlimit: u64,
    dqb-curinodes: u64,
    dqb-btime: u64,
    dqb-itime: u64,
    dqb-valid: u32,
  }

  /// `Q_GETNEXTQUOTA` result (`struct if_nextdqblk`).
  /// @kernel-only
  /// @size(72)
  /// @align(8)
  record if-nextdqblk {
    dqb-bhardlimit: u64,
    dqb-bsoftlimit: u64,
    dqb-curspace: u64,
    dqb-ihardlimit: u64,
    dqb-isoftlimit: u64,
    dqb-curinodes: u64,
    dqb-btime: u64,
    dqb-itime: u64,
    dqb-valid: u32,
    dqb-id: u32,
  }

  /// Quota grace times and flags of one quota type (`struct if_dqinfo`).
  /// @kernel-only
  /// @size(24)
  /// @align(8)
  record if-dqinfo {
    dqi-bgrace: u64,
    dqi-igrace: u64,
    dqi-flags: u32,
    dqi-valid: u32,
  }

  /// `quotactl` commands (`Q_*`, `QCMD(cmd, type)` = `cmd << SUBCMDSHIFT | type`), quota
  /// types, formats and the `dqb-valid`/`dqi-valid` bits (`linux/quota.h`).
  /// @repr(u32)
  enum quota-misc {
    /// @value(0)
    usrquota,
    /// @value(1)
    grpquota,
    /// @value(1)
    qif-blimits,
    /// @value(1)
    iif-bgrace,
    /// @value(1)
    dqf-root-squash,
    /// @value(2)
    prjquota,
    /// @value(2)
    qif-space,
    /// @value(2)
    iif-igrace,
    /// @value(4)
    qif-ilimits,
    /// @value(4)
    iif-flags,
    /// @value(5)
    qfmt-shmem,
    /// @value(7)
    iif-all,
    /// @value(8)
    subcmdshift,
    /// @value(8)
    qif-inodes,
    /// @value(0xff)
    subcmdmask,
    /// @value(16)
    qif-btime,
    /// @value(32)
    qif-itime,
    /// @value(63)
    qif-all,
    /// @value(0x800001)
    q-sync,
    /// @value(0x800002)
    q-quotaon,
    /// @value(0x800003)
    q-quotaoff,
    /// @value(0x800004)
    q-getfmt,
    /// @value(0x800005)
    q-getinfo,
    /// @value(0x800006)
    q-setinfo,
    /// @value(0x800007)
    q-getquota,
    /// @value(0x800008)
    q-setquota,
    /// @value(0x800009)
    q-getnextquota,
  }

  /// A permission event's answer, written to the fanotify descriptor (`struct
  /// fanotify_response`, `linux/fanotify.h`).
  /// @c(struct fanotify_response)
  /// @size(8)
  /// @align(4)
  record fanotify-response {
    fd: s32,
    response: u32,
  }

  /// Header of each information record after an fanotify event (`struct
  /// fanotify_event_info_header`).
  /// @c(struct fanotify_event_info_header)
  /// @size(4)
  /// @align(2)
  record fanotify-event-info-header {
    info-type: u8,
    pad: u8,
    len: u16,
  }

  /// A file identifier record (`struct fanotify_event_info_fid`); a `file-handle` follows at
  /// offset 12, and for `FAN_EVENT_INFO_TYPE_DFID_NAME` a NUL-terminated name after it.
  /// @c(struct fanotify_event_info_fid)
  /// @size(12)
  /// @align(4)
  record fanotify-event-info-fid {
    hdr: fanotify-event-info-header,
    fsid: kernel-fsid,
  }

  /// A pidfd record (`struct fanotify_event_info_pidfd`).
  /// @kernel-only
  /// @size(8)
  /// @align(4)
  record fanotify-event-info-pidfd {
    hdr: fanotify-event-info-header,
    pidfd: s32,
  }

  /// A filesystem error record (`struct fanotify_event_info_error`).
  /// @kernel-only
  /// @size(12)
  /// @align(4)
  record fanotify-event-info-error {
    hdr: fanotify-event-info-header,
    error: s32,
    error-count: u32,
  }

  /// Access range reported with FAN_PRE_ACCESS (linux/fanotify.h).
  /// @kernel-only
  /// @size(24)
  /// @align(8)
  record fanotify-event-info-range {
    hdr: fanotify-event-info-header,
    pad: u32,
    offset: u64,
    count: u64,
  }

  /// A mount record (`struct fanotify_event_info_mnt`).
  /// @kernel-only
  /// @size(16)
  /// @align(8)
  record fanotify-event-info-mnt {
    hdr: fanotify-event-info-header,
    mnt-id: u64,
  }

  /// `fanotify_init` flags (`FAN_CLOEXEC`, `FAN_CLASS_*`, `FAN_REPORT_*`).
  /// @repr(u32)
  /// @c(unsigned)
  flags fanotify-init-flags {
    /// @value(0x0)
    fan-class-notif,
    /// @value(0x1)
    fan-cloexec,
    /// @value(0x2)
    fan-nonblock,
    /// @value(0x4)
    fan-class-content,
    /// @value(0x8)
    fan-class-pre-content,
    /// @value(0xc)
    fan-all-class-bits,
    /// @value(0x10)
    fan-unlimited-queue,
    /// @value(0x20)
    fan-unlimited-marks,
    /// @value(0x40)
    fan-enable-audit,
    /// @value(0x80)
    fan-report-pidfd,
    /// @value(0x100)
    fan-report-tid,
    /// @value(0x200)
    fan-report-fid,
    /// @value(0x400)
    fan-report-dir-fid,
    /// @value(0x800)
    fan-report-name,
    /// @value(0xc00)
    fan-report-dfid-name,
    /// @value(0x1000)
    fan-report-target-fid,
    /// @value(0x1e00)
    fan-report-dfid-name-target,
    /// @value(0x2000)
    fan-report-fd-error,
    /// @value(0x4000)
    fan-report-mnt,
  }

  /// `fanotify_mark` flags (`FAN_MARK_*`).
  /// @repr(u32)
  /// @c(unsigned)
  flags fanotify-mark-flags {
    /// @value(0x0)
    fan-mark-inode,
    /// @value(0x1)
    fan-mark-add,
    /// @value(0x2)
    fan-mark-remove,
    /// @value(0x4)
    fan-mark-dont-follow,
    /// @value(0x8)
    fan-mark-onlydir,
    /// @value(0x10)
    fan-mark-mount,
    /// @value(0x20)
    fan-mark-ignored-mask,
    /// @value(0x40)
    fan-mark-ignored-surv-modify,
    /// @value(0x80)
    fan-mark-flush,
    /// @value(0x100)
    fan-mark-filesystem,
    /// @value(0x110)
    fan-mark-mntns,
    /// @value(0x200)
    fan-mark-evictable,
    /// @value(0x400)
    fan-mark-ignore,
    /// @value(0x440)
    fan-mark-ignore-surv,
  }

  /// fanotify event bits of a mark's mask and of `fanotify-event-metadata.mask` (`FAN_*`).
  /// @repr(u64)
  /// @c(uint64_t)
  flags fanotify-mask {
    /// @value(0x1)
    fan-access,
    /// @value(0x2)
    fan-modify,
    /// @value(0x4)
    fan-attrib,
    /// @value(0x8)
    fan-close-write,
    /// @value(0x10)
    fan-close-nowrite,
    /// @value(0x18)
    fan-close,
    /// @value(0x20)
    fan-open,
    /// @value(0x40)
    fan-moved-from,
    /// @value(0x80)
    fan-moved-to,
    /// @value(0xc0)
    fan-move,
    /// @value(0x100)
    fan-create,
    /// @value(0x200)
    fan-delete,
    /// @value(0x400)
    fan-delete-self,
    /// @value(0x800)
    fan-move-self,
    /// @value(0x1000)
    fan-open-exec,
    /// @value(0x4000)
    fan-q-overflow,
    /// @value(0x8000)
    fan-fs-error,
    /// @value(0x10000)
    fan-open-perm,
    /// @value(0x20000)
    fan-access-perm,
    /// @value(0x40000)
    fan-open-exec-perm,
    /// @value(0x100000)
    fan-pre-access,
    /// @value(0x1000000)
    fan-mnt-attach,
    /// @value(0x2000000)
    fan-mnt-detach,
    /// @value(0x8000000)
    fan-event-on-child,
    /// @value(0x10000000)
    fan-rename,
    /// @value(0x40000000)
    fan-ondir,
  }

  /// fanotify constants: the metadata version, permission responses, the special
  /// descriptor values and the information record types (`linux/fanotify.h`).
  /// @repr(s32)
  enum fanotify-misc {
    /// `FAN_EPIDFD`: the pidfd of a process that is gone.
    /// @value(-2)
    fan-epidfd,
    /// `FAN_NOFD`: an event without a descriptor (FID reporting, overflow).
    /// @value(-1)
    fan-nofd,
    /// @value(-1)
    fan-nopidfd,
    /// @value(0)
    fan-response-info-none,
    /// @value(1)
    fan-allow,
    /// @value(1)
    fan-event-info-type-fid,
    /// @value(1)
    fan-response-info-audit-rule,
    /// @value(2)
    fan-deny,
    /// @value(2)
    fan-event-info-type-dfid-name,
    /// @value(3)
    fan-event-info-type-dfid,
    /// @value(3)
    fanotify-metadata-version,
    /// @value(4)
    fan-event-info-type-pidfd,
    /// @value(5)
    fan-event-info-type-error,
    /// @value(6)
    fan-event-info-type-range,
    /// @value(7)
    fan-event-info-type-mnt,
    /// @value(8)
    fan-errno-bits,
    /// @value(10)
    fan-event-info-type-old-dfid-name,
    /// @value(12)
    fan-event-info-type-new-dfid-name,
    /// @value(0x10)
    fan-audit,
    /// @value(24)
    fan-errno-shift,
    /// @value(0x20)
    fan-info,
    /// @value(0xff)
    fan-errno-mask,
  }

  // ==== Polling and event notification ====

  /// `ppoll_time64` entry (`struct pollfd`).
  /// @c(struct pollfd)
  /// @size(8)
  /// @align(4)
  record pollfd {
    fd: fd,
    events: poll-events,
    revents: poll-events,
  }

  /// User data of an epoll event (kernel: a plain `__u64`).
  /// @c(union epoll_data)
  /// @union
  /// @size(8)
  /// @align(8)
  record epoll-data {
    ptr: uptr,
    fd: fd,
    %u32: u32,
    %u64: u64,
  }

  /// epoll event (`struct epoll_event`). Not packed on asm-generic: 4 bytes of implicit padding
  /// follow `events`.
  /// @c(struct epoll_event)
  /// @size(16)
  /// @align(8)
  record epoll-event {
    events: epoll-events,
    data: epoll-data,
  }

  /// 1024-bit descriptor set for `pselect6_time64` (`__kernel_fd_set`).
  /// @c(fd_set)
  /// @size(128)
  /// @align(4)
  record kernel-fd-set {
    fds-bits: list<ulong, 32>,
  }

  /// `pollfd.events`/`revents` (`asm-generic/poll.h`). C type is `short`.
  /// @repr(u16)
  /// @c(short)
  flags poll-events {
    /// @value(0x1)
    pollin,
    /// @value(0x2)
    pollpri,
    /// @value(0x4)
    pollout,
    /// @value(0x8)
    pollerr,
    /// @value(0x10)
    pollhup,
    /// @value(0x20)
    pollnval,
    /// @value(0x40)
    pollrdnorm,
    /// @value(0x80)
    pollrdband,
    /// @value(0x100)
    pollwrnorm,
    /// @value(0x200)
    pollwrband,
    /// @value(0x400)
    pollmsg,
    /// @value(0x1000)
    pollremove,
    /// @value(0x2000)
    pollrdhup,
  }

  /// `epoll_event.events` (`linux/eventpoll.h`).
  /// @repr(u32)
  /// @c(uint32_t)
  flags epoll-events {
    /// From `linux/eventpoll.h` (not in the extracted constant set).
    /// @value(0x1)
    epollin,
    /// From `linux/eventpoll.h` (not in the extracted constant set).
    /// @value(0x2)
    epollpri,
    /// From `linux/eventpoll.h` (not in the extracted constant set).
    /// @value(0x4)
    epollout,
    /// From `linux/eventpoll.h` (not in the extracted constant set).
    /// @value(0x8)
    epollerr,
    /// From `linux/eventpoll.h` (not in the extracted constant set).
    /// @value(0x10)
    epollhup,
    /// From `linux/eventpoll.h` (not in the extracted constant set).
    /// @value(0x20)
    epollnval,
    /// From `linux/eventpoll.h` (not in the extracted constant set).
    /// @value(0x40)
    epollrdnorm,
    /// From `linux/eventpoll.h` (not in the extracted constant set).
    /// @value(0x80)
    epollrdband,
    /// From `linux/eventpoll.h` (not in the extracted constant set).
    /// @value(0x100)
    epollwrnorm,
    /// From `linux/eventpoll.h` (not in the extracted constant set).
    /// @value(0x200)
    epollwrband,
    /// From `linux/eventpoll.h` (not in the extracted constant set).
    /// @value(0x400)
    epollmsg,
    /// From `linux/eventpoll.h` (not in the extracted constant set).
    /// @value(0x2000)
    epollrdhup,
    /// From `linux/eventpoll.h` (not in the extracted constant set).
    /// @value(0x8000000)
    epoll-uring-wake,
    /// From `linux/eventpoll.h` (not in the extracted constant set).
    /// @value(0x10000000)
    epollexclusive,
    /// From `linux/eventpoll.h` (not in the extracted constant set).
    /// @value(0x20000000)
    epollwakeup,
    /// From `linux/eventpoll.h` (not in the extracted constant set).
    /// @value(0x40000000)
    epolloneshot,
    /// From `linux/eventpoll.h` (not in the extracted constant set).
    /// @value(0x80000000)
    epollet,
  }

  /// `epoll_create1` flags (`linux/eventpoll.h`).
  /// @repr(u32)
  /// @c(int)
  flags epoll-create-flags {
    /// @value(0x80000)
    epoll-cloexec,
  }

  /// `epoll_ctl` operations (`linux/eventpoll.h`).
  /// @repr(s32)
  /// @c(int)
  enum epoll-ctl-op {
    /// @value(1)
    epoll-ctl-add,
    /// @value(2)
    epoll-ctl-del,
    /// @value(3)
    epoll-ctl-mod,
  }

  /// `eventfd2` flags (`linux/eventfd.h`).
  /// @repr(u32)
  /// @c(int)
  flags eventfd-flags {
    /// @value(0x1)
    efd-semaphore,
    /// @value(0x800)
    efd-nonblock,
    /// @value(0x80000)
    efd-cloexec,
  }

  /// `signalfd4` flags (`linux/signalfd.h`).
  /// @repr(u32)
  /// @c(int)
  flags signalfd-flags {
    /// @value(0x800)
    sfd-nonblock,
    /// @value(0x80000)
    sfd-cloexec,
  }

  // ==== Signals ====

  /// Kernel signal set (`sigset_t` in `asm-generic/signal.h`): 64 signals, 8 bytes.
  /// Every `sigsetsize` argument must be 8. musl's 128-byte user `sigset_t` starts with the same words.
  /// @kernel-only
  /// @size(8)
  /// @align(4)
  record sigset {
    sig: list<ulong, 2>,
  }

  /// Kernel signal action for `rt_sigaction` (asm-generic `struct sigaction`, 16 bytes).
  /// riscv has no `SA_RESTORER`, so there is no `sa_restorer` field. musl passes its internal
  /// `struct k_sigaction` (`src/internal/ksigaction.h`); upstream musl riscv32 wrongly adds a
  /// restorer field (20 bytes), which the wasixv2 port must not do.
  /// @c(struct k_sigaction)
  /// @size(16)
  /// @align(4)
  record sigaction {
    /// Handler address, or a `signal-handler` value.
    /// @c-name(handler)
    sa-handler: uptr,
    /// `sa-flags` bits.
    /// @c-name(flags)
    sa-flags: ulong,
    /// @c-name(mask)
    sa-mask: sigset,
  }

  /// Alternate signal stack (`stack_t`, `struct sigaltstack`).
  /// @c(stack_t)
  /// @size(12)
  /// @align(4)
  record sigaltstack {
    ss-sp: uptr,
    /// `sigaltstack-flags` bits.
    ss-flags: s32,
    ss-size: usize,
  }

  /// Signal value (`union sigval`).
  /// @c(union sigval)
  /// @union
  /// @size(4)
  /// @align(4)
  record sigval {
    sival-int: s32,
    sival-ptr: uptr,
  }

  /// Signal information (`siginfo_t`, 128 bytes). Only the common header is modelled; `sifields`
  /// is the `union __sifields` padded to 116 bytes. Offsets of the common union members:
  ///
  /// - kill/rt: `si_pid` 12, `si_uid` 16, `si_value` 20
  /// - timer: `si_tid` 12, `si_overrun` 16, `si_value` 20
  /// - SIGCHLD: `si_pid` 12, `si_uid` 16, `si_status` 20, `si_utime` 24, `si_stime` 28 (32-bit clock_t)
  /// - SIGILL/SIGFPE/SIGSEGV/SIGBUS: `si_addr` 12
  /// - SIGPOLL: `si_band` 12 (long), `si_fd` 16
  /// - SIGSYS: `si_call_addr` 12, `si_syscall` 16, `si_arch` 20
  /// @c(siginfo_t)
  /// @size(128)
  /// @align(4)
  record siginfo {
    si-signo: s32,
    si-errno: s32,
    /// `si-code` value.
    si-code: s32,
    /// musl: `__si_fields`.
    /// @c-name(__si_fields)
    sifields: list<u8, 116>,
  }

  /// `SIGEV_THREAD` member of `sigevent-un` (anonymous struct `_sigev_thread`).
  /// @kernel-only
  /// @size(8)
  /// @align(4)
  record sigevent-thread {
    /// @c-name(_function)
    function: uptr,
    /// @c-name(_attribute)
    attribute: uptr,
  }

  /// The `_sigev_un` union of `sigevent`.
  /// @kernel-only
  /// @union
  /// @size(52)
  /// @align(4)
  record sigevent-un {
    /// @c-name(_pad)
    pad: list<s32, 13>,
    /// Thread id for `SIGEV_THREAD_ID`.
    /// @c-name(_tid)
    tid: pid,
    /// @c-name(_sigev_thread)
    sigev-thread: sigevent-thread,
  }

  /// Notification request for `timer_create` and `mq_notify` (`struct sigevent`, 64 bytes).
  /// @c(struct sigevent)
  /// @size(64)
  /// @align(4)
  record sigevent {
    sigev-value: sigval,
    sigev-signo: s32,
    /// `sigev-notify` value.
    sigev-notify: s32,
    /// musl: `__sev_fields`.
    /// @c-name(__sev_fields)
    sigev-un: sigevent-un,
  }

  /// Record read from a signalfd (`struct signalfd_siginfo`).
  /// @c(struct signalfd_siginfo)
  /// @size(128)
  /// @align(8)
  record signalfd-siginfo {
    ssi-signo: u32,
    ssi-errno: s32,
    ssi-code: s32,
    ssi-pid: u32,
    ssi-uid: u32,
    ssi-fd: s32,
    ssi-tid: u32,
    ssi-band: u32,
    ssi-overrun: u32,
    ssi-trapno: u32,
    ssi-status: s32,
    ssi-int: s32,
    ssi-ptr: u64,
    ssi-utime: u64,
    ssi-stime: u64,
    ssi-addr: u64,
    ssi-addr-lsb: u16,
    /// @c-name(__pad2)
    pad2: u16,
    ssi-syscall: s32,
    ssi-call-addr: u64,
    ssi-arch: u32,
    /// @c-name(__pad)
    pad: list<u8, 28>,
  }

  /// 6th argument of `pselect6_time64` (`struct sigset_argpack` in fs/select.c).
  /// @kernel-only
  /// @size(8)
  /// @align(4)
  record sigset-argpack {
    p: const-sigset-ptr,
    size: usize,
  }

  /// Signal numbers (`asm-generic/signal.h`).
  /// musl reserves 32..34 internally, so its `SIGRTMIN` is 35; the kernel value is 32.
  /// @repr(s32)
  /// @c(int)
  enum signal {
    /// @value(1)
    sighup,
    /// @value(2)
    sigint,
    /// @value(3)
    sigquit,
    /// @value(4)
    sigill,
    /// @value(5)
    sigtrap,
    /// @value(6)
    sigabrt,
    /// @value(6)
    sigiot,
    /// @value(7)
    sigbus,
    /// @value(8)
    sigfpe,
    /// @value(9)
    sigkill,
    /// @value(10)
    sigusr1,
    /// @value(11)
    sigsegv,
    /// @value(12)
    sigusr2,
    /// @value(13)
    sigpipe,
    /// @value(14)
    sigalrm,
    /// @value(15)
    sigterm,
    /// @value(16)
    sigstkflt,
    /// @value(17)
    sigchld,
    /// @value(18)
    sigcont,
    /// @value(19)
    sigstop,
    /// @value(20)
    sigtstp,
    /// @value(21)
    sigttin,
    /// @value(22)
    sigttou,
    /// @value(23)
    sigurg,
    /// @value(24)
    sigxcpu,
    /// @value(25)
    sigxfsz,
    /// @value(26)
    sigvtalrm,
    /// @value(27)
    sigprof,
    /// @value(28)
    sigwinch,
    /// @value(29)
    sigio,
    /// @value(29)
    sigpoll,
    /// @value(30)
    sigpwr,
    /// @value(31)
    sigsys,
    /// @value(31)
    sigunused,
    /// @value(32)
    /// No C assert: musl's `SIGRTMIN` is a function call (`__libc_current_sigrtmin()`), not a constant.
    /// @c-skip
    sigrtmin,
    /// @value(64)
    /// No C assert: musl's `SIGRTMAX` is a function call (`__libc_current_sigrtmax()`), not a constant.
    /// @c-skip
    sigrtmax,
  }

  /// Signal-related sizes (`asm-generic/signal.h`, `asm-generic/siginfo.h`).
  /// @repr(u32)
  enum signal-limits {
    /// @name(_NSIG_WORDS)
    /// @value(2)
    nsig-words,
    /// @value(13)
    sigev-pad-size,
    /// @name(_NSIG_BPW)
    /// @value(32)
    nsig-bpw,
    /// @value(64)
    sigev-max-size,
    /// @name(_NSIG)
    /// @value(64)
    /// No C assert: musl's `_NSIG` is 65 (signals 1..64 plus one), the kernel's is 64.
    /// @c-skip
    nsig,
    /// @value(2048)
    minsigstksz,
    /// @value(8192)
    sigstksz,
  }

  /// `sigaction.sa_flags` (`asm-generic/signal-defs.h`).
  /// riscv (and therefore wasixv2) has no `SA_RESTORER`.
  /// @repr(u32)
  /// @c(unsigned long)
  flags sa-flags {
    /// @value(0x1)
    sa-nocldstop,
    /// @value(0x2)
    sa-nocldwait,
    /// @value(0x4)
    sa-siginfo,
    /// @value(0x400)
    sa-unsupported,
    /// @value(0x800)
    sa-expose-tagbits,
    /// @value(0x8000000)
    sa-onstack,
    /// @value(0x10000000)
    sa-restart,
    /// @value(0x40000000)
    sa-nodefer,
    /// @value(0x40000000)
    sa-nomask,
    /// @value(0x80000000)
    sa-oneshot,
    /// @value(0x80000000)
    sa-resethand,
  }

  /// Special `sa_handler` values (`asm-generic/signal-defs.h`).
  /// @repr(s32)
  enum signal-handler {
    /// From `asm-generic/signal-defs.h` (not in the extracted constant set).
    /// @value(0)
    sig-dfl,
    /// From `asm-generic/signal-defs.h` (not in the extracted constant set).
    /// @value(1)
    sig-ign,
    /// From `asm-generic/signal-defs.h` (not in the extracted constant set).
    /// @value(-1)
    sig-err,
  }

  /// `how` for `rt_sigprocmask` (`asm-generic/signal-defs.h`).
  /// @repr(s32)
  /// @c(int)
  enum sigprocmask-how {
    /// From `asm-generic/signal-defs.h` (not in the extracted constant set).
    /// @value(0)
    sig-block,
    /// From `asm-generic/signal-defs.h` (not in the extracted constant set).
    /// @value(1)
    sig-unblock,
    /// From `asm-generic/signal-defs.h` (not in the extracted constant set).
    /// @value(2)
    sig-setmask,
  }

  /// `stack_t.ss_flags` (`linux/signal.h`).
  /// @repr(u32)
  /// @c(int)
  flags sigaltstack-flags {
    /// From `linux/signal.h` (not in the extracted constant set).
    /// @value(0x1)
    ss-onstack,
    /// From `linux/signal.h` (not in the extracted constant set).
    /// @value(0x2)
    ss-disable,
    /// From `linux/signal.h` (not in the extracted constant set).
    /// @value(0x80000000)
    ss-autodisarm,
  }

  /// `siginfo.si_code` values (`asm-generic/siginfo.h`).
  /// The meaning of positive values depends on the signal number.
  /// @repr(s32)
  /// @c(int)
  enum si-code {
    /// @value(0)
    si-user,
    /// @value(1)
    bus-adraln,
    /// @value(1)
    cld-exited,
    /// @value(1)
    fpe-intdiv,
    /// @value(1)
    ill-illopc,
    /// @value(1)
    poll-in,
    /// @value(1)
    segv-maperr,
    /// @value(1)
    sys-seccomp,
    /// @value(1)
    trap-brkpt,
    /// @value(2)
    bus-adrerr,
    /// @value(2)
    cld-killed,
    /// @value(2)
    fpe-intovf,
    /// @value(2)
    ill-illopn,
    /// @value(2)
    poll-out,
    /// @value(2)
    segv-accerr,
    /// @value(2)
    sys-user-dispatch,
    /// @value(2)
    trap-trace,
    /// @value(3)
    bus-objerr,
    /// @value(3)
    cld-dumped,
    /// @value(3)
    fpe-fltdiv,
    /// @value(3)
    ill-illadr,
    /// @value(3)
    poll-msg,
    /// @value(3)
    segv-bnderr,
    /// @value(3)
    trap-branch,
    /// @value(4)
    bus-mceerr-ar,
    /// @value(4)
    cld-trapped,
    /// @value(4)
    fpe-fltovf,
    /// @value(4)
    ill-illtrp,
    /// @value(4)
    poll-err,
    /// @value(4)
    segv-pkuerr,
    /// @value(4)
    trap-hwbkpt,
    /// @value(5)
    bus-mceerr-ao,
    /// @value(5)
    cld-stopped,
    /// @value(5)
    fpe-fltund,
    /// @value(5)
    ill-prvopc,
    /// @value(5)
    poll-pri,
    /// @value(5)
    segv-accadi,
    /// @value(5)
    trap-unk,
    /// @value(6)
    cld-continued,
    /// @value(6)
    fpe-fltres,
    /// @value(6)
    ill-prvreg,
    /// @value(6)
    poll-hup,
    /// @value(6)
    segv-adiderr,
    /// @value(6)
    trap-perf,
    /// @value(7)
    fpe-fltinv,
    /// @value(7)
    ill-coproc,
    /// @value(7)
    segv-adiperr,
    /// @value(8)
    fpe-fltsub,
    /// @value(8)
    ill-badstk,
    /// @value(8)
    segv-mteaerr,
    /// @value(9)
    ill-badiaddr,
    /// @value(9)
    segv-mteserr,
    /// @value(10)
    segv-cperr,
    /// @value(14)
    fpe-fltunk,
    /// @value(15)
    fpe-condtrap,
    /// @value(128)
    si-kernel,
    /// @value(-60)
    si-asyncnl,
    /// @value(-7)
    si-dethread,
    /// @value(-6)
    si-tkill,
    /// @value(-5)
    si-sigio,
    /// @value(-4)
    si-asyncio,
    /// @value(-3)
    si-mesgq,
    /// @value(-2)
    si-timer,
    /// @value(-1)
    si-queue,
  }

  /// `sigevent.sigev_notify` (`asm-generic/siginfo.h`).
  /// @repr(s32)
  /// @c(int)
  enum sigev-notify {
    /// @value(0)
    sigev-signal,
    /// @value(1)
    sigev-none,
    /// @value(2)
    sigev-thread,
    /// @value(4)
    sigev-thread-id,
  }

  // ==== Processes, scheduling and resources ====

  /// Resource usage with legacy 32-bit `timeval`s (kernel `struct rusage`, 72 bytes).
  /// musl's 152-byte `struct rusage` is different: it lets the kernel fill the start and converts.
  /// @kernel-only
  /// @size(72)
  /// @align(4)
  record rusage {
    ru-utime: kernel-old-timeval,
    ru-stime: kernel-old-timeval,
    ru-maxrss: slong,
    ru-ixrss: slong,
    ru-idrss: slong,
    ru-isrss: slong,
    ru-minflt: slong,
    ru-majflt: slong,
    ru-nswap: slong,
    ru-inblock: slong,
    ru-oublock: slong,
    ru-msgsnd: slong,
    ru-msgrcv: slong,
    ru-nsignals: slong,
    ru-nvcsw: slong,
    ru-nivcsw: slong,
  }

  /// Resource limit for `prlimit64` (`struct rlimit64`). See `rlim-value` for infinity.
  /// @c(struct rlimit)
  /// @size(16)
  /// @align(8)
  record rlimit64 {
    rlim-cur: u64,
    rlim-max: u64,
  }

  /// System statistics (kernel `struct sysinfo`, 64 bytes).
  /// musl's 312-byte `struct sysinfo` is a prefix-compatible superset.
  /// @kernel-only
  /// @size(64)
  /// @align(4)
  record sysinfo {
    uptime: slong,
    loads: list<ulong, 3>,
    totalram: ulong,
    freeram: ulong,
    sharedram: ulong,
    bufferram: ulong,
    totalswap: ulong,
    freeswap: ulong,
    procs: u16,
    pad: u16,
    totalhigh: ulong,
    freehigh: ulong,
    mem-unit: u32,
    /// @c-name(_f)
    f: list<u8, 8>,
  }

  /// `uname` result (`struct new_utsname`), six NUL-terminated 65-byte strings.
  /// musl names the last field `__domainname` unless `_GNU_SOURCE` is defined.
  /// @c(struct utsname)
  /// @size(390)
  /// @align(1)
  record new-utsname {
    sysname: list<u8, 65>,
    nodename: list<u8, 65>,
    release: list<u8, 65>,
    version: list<u8, 65>,
    machine: list<u8, 65>,
    domainname: list<u8, 65>,
  }

  /// Kernel `struct sched_param` (4 bytes). musl's 48-byte struct is a prefix-compatible superset.
  /// @kernel-only
  /// @size(4)
  /// @align(4)
  record sched-param {
    sched-priority: s32,
  }

  /// `sched_setattr`/`sched_getattr` attributes (`struct sched_attr`, size-versioned; VER1 = 56).
  /// @kernel-only
  /// @size(56)
  /// @align(8)
  record sched-attr {
    size: u32,
    sched-policy: u32,
    sched-flags: sched-flags,
    sched-nice: s32,
    sched-priority: u32,
    sched-runtime: u64,
    sched-deadline: u64,
    sched-period: u64,
    sched-util-min: u32,
    sched-util-max: u32,
  }

  /// `clone3` arguments (`struct clone_args`, size-versioned; VER2 = 88).
  /// Pointer fields hold zero-extended guest addresses.
  /// @kernel-only
  /// @size(88)
  /// @align(8)
  record clone-args {
    %flags: clone-flags,
    pidfd: u64,
    child-tid: u64,
    parent-tid: u64,
    exit-signal: u64,
    stack: u64,
    stack-size: u64,
    tls: u64,
    set-tid: u64,
    set-tid-size: u64,
    cgroup: u64,
  }

  /// `capget`/`capset` header (`struct __user_cap_header_struct`).
  /// @kernel-only
  /// @size(8)
  /// @align(4)
  record user-cap-header-struct {
    version: u32,
    pid: pid,
  }

  /// `capget`/`capset` data (`struct __user_cap_data_struct`); version 3 uses two of them.
  /// @kernel-only
  /// @size(12)
  /// @align(4)
  record user-cap-data-struct {
    effective: u32,
    permitted: u32,
    inheritable: u32,
  }

  /// Robust futex list entry (`struct robust_list`).
  /// @kernel-only
  /// @size(4)
  /// @align(4)
  record robust-list {
    next: uptr,
  }

  /// Robust futex list head (`struct robust_list_head`); `set_robust_list` requires len 12.
  /// @kernel-only
  /// @size(12)
  /// @align(4)
  record robust-list-head {
    %list: robust-list,
    futex-offset: slong,
    list-op-pending: uptr,
  }

  /// `kexec_load` segment (`struct kexec_segment`).
  /// @kernel-only
  /// @size(16)
  /// @align(4)
  record kexec-segment {
    buf: uptr,
    bufsz: usize,
    mem: uptr,
    memsz: usize,
  }

  /// `CLONE_*` flags (`linux/sched.h`): `clone` takes the low 32 bits, `clone3` all 64.
  /// `CSIGNAL` masks the exit signal in the low byte of `clone` flags.
  /// @repr(u64)
  /// @c(uint64_t)
  flags clone-flags {
    /// @value(0x80)
    clone-newtime,
    /// @value(0xff)
    csignal,
    /// @value(0x100)
    clone-vm,
    /// @value(0x200)
    clone-fs,
    /// @value(0x400)
    clone-files,
    /// @value(0x800)
    clone-sighand,
    /// @value(0x1000)
    clone-pidfd,
    /// @value(0x2000)
    clone-ptrace,
    /// @value(0x4000)
    clone-vfork,
    /// @value(0x8000)
    clone-parent,
    /// @value(0x10000)
    clone-thread,
    /// @value(0x20000)
    clone-newns,
    /// @value(0x40000)
    clone-sysvsem,
    /// @value(0x80000)
    clone-settls,
    /// @value(0x100000)
    clone-parent-settid,
    /// @value(0x200000)
    clone-child-cleartid,
    /// @value(0x400000)
    clone-detached,
    /// @value(0x800000)
    clone-untraced,
    /// @value(0x1000000)
    clone-child-settid,
    /// @value(0x2000000)
    clone-newcgroup,
    /// @value(0x4000000)
    clone-newuts,
    /// @value(0x8000000)
    clone-newipc,
    /// @value(0x10000000)
    clone-newuser,
    /// @value(0x20000000)
    clone-newpid,
    /// @value(0x40000000)
    clone-newnet,
    /// @value(0x80000000)
    clone-io,
    /// @value(0x100000000)
    clone-clear-sighand,
    /// @value(0x200000000)
    clone-into-cgroup,
    /// @value(0x400000000)
    clone-autoreap,
    /// @value(0x800000000)
    clone-nnp,
    /// @value(0x1000000000)
    clone-pidfd-autokill,
    /// @value(0x2000000000)
    clone-empty-mntns,
  }

