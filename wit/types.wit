/// Linux syscall ABI for wasm32 guests, mirroring riscv32 (asm-generic, ILP32, time64 only).
///
/// See README.md in this directory for the annotation conventions.
package wasixv2:linux@0.1.0;

/// Primitive aliases, structs, unions and constant families shared by all interfaces.
///
/// Layouts are the kernel's view on riscv32, which is byte-identical to wasm32.
interface types {
  // ==== Pointer-sized base types ====

  /// Guest address. On wasm32 this is an offset into linear memory.
  /// @pointer-sized
  /// @c(uintptr_t)
  type uptr = u32;

  /// C `unsigned long` (`__kernel_ulong_t`).
  /// @pointer-sized
  /// @c(unsigned long)
  type ulong = u32;

  /// C `long` (`__kernel_long_t`). Every syscall returns it: a value, or `-errno`.
  /// @pointer-sized
  /// @c(long)
  type slong = s32;

  /// C `size_t` (`__kernel_size_t`).
  /// @pointer-sized
  /// @c(size_t)
  type usize = u32;

  /// C `ssize_t` (`__kernel_ssize_t`).
  /// @pointer-sized
  /// @c(ssize_t)
  type ssize = s32;

  // ==== Scalar types ====

  /// File descriptor. Kernel prototypes mix `int` and `unsigned int`; the bits are the same.
  /// @c(int)
  /// @newtype
  type fd = s32;

  /// Process, thread, process group or session id (`__kernel_pid_t`).
  /// @c(pid_t)
  type pid = s32;

  /// User id (`__kernel_uid32_t`).
  /// @c(uid_t)
  type uid = u32;

  /// Group id (`__kernel_gid32_t`).
  /// @c(gid_t)
  type gid = u32;

  /// File mode. The kernel's `umode_t` is 16 bits in memory but passed as a full register.
  /// @c(mode_t)
  type mode = u32;

  /// 64-bit file offset (`loff_t`, `__kernel_loff_t`).
  /// @c(off_t)
  type loff = s64;

  /// 64-bit seconds (`__kernel_time64_t`).
  /// @c(time_t)
  type time = s64;

  /// Clock tick count (`__kernel_clock_t`, a `long`).
  /// @c(clock_t)
  type kernel-clock = slong;

  /// Clock id, see `clock-id` for the constants.
  /// @c(clockid_t)
  type clockid = s32;

  /// Kernel POSIX timer id (`__kernel_timer_t` is `int`; musl's `timer_t` is a pointer it converts from).
  /// @c(int)
  type timer-id = s32;

  /// SysV IPC key.
  /// @c(key_t)
  type key = s32;

  /// POSIX message queue descriptor (an fd).
  /// @c(mqd_t)
  type mqd = s32;

  /// Quota id (`qid_t`).
  /// @c(unsigned)
  type qid = u32;

  /// Key serial number for the key management syscalls (`key_serial_t`).
  /// @c(int)
  type key-serial = s32;

  /// `preadv2`/`pwritev2` flags type (`__kernel_rwf_t`), see `rwf-flags`.
  /// @c(int)
  type rwf = s32;

  /// Linux native AIO context handle (`aio_context_t`, `__kernel_ulong_t`).
  /// @c(unsigned long)
  type aio-context = ulong;

  /// Socket address length.
  /// @c(socklen_t)
  type socklen = u32;

  /// Socket address family as stored in `sockaddr` (`__kernel_sa_family_t`), see `address-family`.
  /// @c(sa_family_t)
  type sa-family = u16;

  // ==== Guest pointers ====

  /// NUL-terminated string.
  /// @ptr(const u8[])
  /// @c(const char *)
  type cstr = uptr;

  /// NULL-terminated array of string pointers (`argv`, `envp`).
  /// @ptr(const cstr[])
  /// @c(char *const *)
  type cstr-array = uptr;

  /// Output byte buffer; its length is a separate argument.
  /// @ptr(mut u8[])
  /// @c(void *)
  type buf = uptr;

  /// Input byte buffer; its length is a separate argument.
  /// @ptr(const u8[])
  /// @c(const void *)
  type const-buf = uptr;

  /// Untyped pointer whose pointee depends on other arguments.
  /// @ptr(mut void)
  /// @c(void *)
  type void-ptr = uptr;

  /// Untyped read-only pointer whose pointee depends on other arguments.
  /// @ptr(const void)
  /// @c(const void *)
  type const-void-ptr = uptr;

  /// Array of guest addresses (`const void **`).
  /// @ptr(const uptr[])
  /// @c(const void **)
  type const-uptr-array = uptr;

  /// @ptr(mut s32)
  /// @c(int *)
  type s32-ptr = uptr;

  /// @ptr(mut s32[])
  /// @c(int *)
  type s32-array = uptr;

  /// @ptr(const s32[])
  /// @c(const int *)
  type const-s32-array = uptr;

  /// Two file descriptors (`pipe2`, `socketpair`).
  /// @ptr(mut fd[])
  /// @c(int *)
  type fd-pair = uptr;

  /// @ptr(mut u32)
  /// @c(unsigned *)
  type u32-ptr = uptr;

  /// @ptr(mut u64)
  /// @c(uint64_t *)
  type u64-ptr = uptr;

  /// @ptr(mut uptr)
  /// @c(uintptr_t *)
  type uptr-ptr = uptr;

  /// @ptr(mut u64[])
  /// @c(uint64_t *)
  type u64-array = uptr;

  /// Bitmask array of `unsigned long` words (CPU and NUMA node masks).
  /// @ptr(mut ulong[])
  /// @c(unsigned long *)
  type ulong-array = uptr;

  /// Read-only bitmask array of `unsigned long` words.
  /// @ptr(const ulong[])
  /// @c(const unsigned long *)
  type const-ulong-array = uptr;

  /// @ptr(mut usize)
  /// @c(size_t *)
  type usize-ptr = uptr;

  /// @ptr(mut loff)
  /// @c(off_t *)
  type loff-ptr = uptr;

  /// In/out socket address length. The kernel declares it `int *`.
  /// @ptr(mut socklen)
  /// @c(socklen_t *)
  type socklen-ptr = uptr;

  /// @ptr(mut uid)
  /// @c(uid_t *)
  type uid-ptr = uptr;

  /// @ptr(mut gid)
  /// @c(gid_t *)
  type gid-ptr = uptr;

  /// @ptr(mut gid[])
  /// @c(gid_t *)
  type gid-array = uptr;

  /// @ptr(const gid[])
  /// @c(const gid_t *)
  type const-gid-array = uptr;

  /// @ptr(mut aio-context)
  /// @c(unsigned long *)
  type aio-context-ptr = uptr;

  /// @ptr(mut timer-id)
  /// @c(int *)
  type timer-id-ptr = uptr;

  /// @ptr(mut kernel-timespec)
  type kernel-timespec-ptr = uptr;

  /// @ptr(const kernel-timespec)
  type const-kernel-timespec-ptr = uptr;

  /// `utimensat_time64` times: two entries (atime, mtime).
  /// @ptr(const kernel-timespec[])
  type const-kernel-timespec-array = uptr;

  /// @ptr(mut kernel-itimerspec)
  type kernel-itimerspec-ptr = uptr;

  /// @ptr(const kernel-itimerspec)
  type const-kernel-itimerspec-ptr = uptr;

  /// @ptr(mut kernel-old-itimerval)
  type kernel-old-itimerval-ptr = uptr;

  /// @ptr(const kernel-old-itimerval)
  type const-kernel-old-itimerval-ptr = uptr;

  /// @ptr(mut kernel-timex)
  type kernel-timex-ptr = uptr;

  /// @ptr(mut tms)
  type tms-ptr = uptr;

  /// @ptr(mut rusage)
  type rusage-ptr = uptr;

  /// @ptr(mut rlimit64)
  type rlimit64-ptr = uptr;

  /// @ptr(const rlimit64)
  type const-rlimit64-ptr = uptr;

  /// @ptr(mut sysinfo)
  type sysinfo-ptr = uptr;

  /// @ptr(mut new-utsname)
  type new-utsname-ptr = uptr;

  /// @ptr(mut sched-param)
  type sched-param-ptr = uptr;

  /// @ptr(const sched-param)
  type const-sched-param-ptr = uptr;

  /// @ptr(mut sched-attr)
  type sched-attr-ptr = uptr;

  /// @ptr(const clone-args)
  type const-clone-args-ptr = uptr;

  /// @ptr(mut user-cap-header-struct)
  type user-cap-header-ptr = uptr;

  /// @ptr(mut user-cap-data-struct[])
  type user-cap-data-array = uptr;

  /// @ptr(const user-cap-data-struct[])
  type const-user-cap-data-array = uptr;

  /// @ptr(mut robust-list-head)
  type robust-list-head-ptr = uptr;

  /// @ptr(mut robust-list-head-ptr)
  type robust-list-head-ptr-ptr = uptr;

  /// @ptr(const futex-waitv[])
  type const-futex-waitv-array = uptr;

  /// @ptr(const kexec-segment[])
  type const-kexec-segment-array = uptr;

  /// @ptr(mut sigset)
  type sigset-ptr = uptr;

  /// @ptr(const sigset)
  type const-sigset-ptr = uptr;

  /// @ptr(mut sigaction)
  type sigaction-ptr = uptr;

  /// @ptr(const sigaction)
  type const-sigaction-ptr = uptr;

  /// @ptr(mut sigaltstack)
  type sigaltstack-ptr = uptr;

  /// @ptr(const sigaltstack)
  type const-sigaltstack-ptr = uptr;

  /// @ptr(mut siginfo)
  type siginfo-ptr = uptr;

  /// @ptr(const siginfo)
  type const-siginfo-ptr = uptr;

  /// @ptr(const sigevent)
  type const-sigevent-ptr = uptr;

  /// @ptr(const sigset-argpack)
  type const-sigset-argpack-ptr = uptr;

  /// @ptr(const aio-sigset)
  type const-aio-sigset-ptr = uptr;

  /// @ptr(mut statx)
  type statx-ptr = uptr;

  /// @ptr(mut statfs64)
  type statfs64-ptr = uptr;

  /// Buffer receiving a sequence of variable-length `linux_dirent64` records.
  /// @ptr(mut linux-dirent64)
  type linux-dirent64-ptr = uptr;

  /// @ptr(mut file-handle)
  type file-handle-ptr = uptr;

  /// @ptr(const file-handle)
  type const-file-handle-ptr = uptr;

  /// @ptr(const open-how)
  type const-open-how-ptr = uptr;

  /// @ptr(const iovec[])
  type const-iovec-array = uptr;

  /// @ptr(const sock-filter[])
  type const-sock-filter-array = uptr;

  /// @ptr(mut xattr-args)
  type xattr-args-ptr = uptr;

  /// @ptr(const xattr-args)
  type const-xattr-args-ptr = uptr;

  /// @ptr(mut file-attr)
  type file-attr-ptr = uptr;

  /// @ptr(const file-attr)
  type const-file-attr-ptr = uptr;

  /// @ptr(const cachestat-range)
  type const-cachestat-range-ptr = uptr;

  /// @ptr(mut cachestat)
  type cachestat-ptr = uptr;

  /// @ptr(const mount-attr)
  type const-mount-attr-ptr = uptr;

  /// @ptr(const mnt-id-req)
  type const-mnt-id-req-ptr = uptr;

  /// @ptr(const ns-id-req)
  type const-ns-id-req-ptr = uptr;

  /// @ptr(mut lsm-ctx)
  type lsm-ctx-ptr = uptr;

  /// @ptr(const lsm-ctx)
  type const-lsm-ctx-ptr = uptr;

  /// @ptr(const landlock-ruleset-attr)
  type const-landlock-ruleset-attr-ptr = uptr;

  /// @ptr(mut pollfd[])
  type pollfd-array = uptr;

  /// @ptr(const epoll-event)
  type const-epoll-event-ptr = uptr;

  /// @ptr(mut epoll-event[])
  type epoll-event-array = uptr;

  /// @ptr(mut kernel-fd-set)
  type kernel-fd-set-ptr = uptr;

  /// Output socket address buffer; its capacity is passed via a `socklen-ptr`.
  /// @ptr(mut sockaddr)
  type sockaddr-ptr = uptr;

  /// Input socket address; the actual layout is selected by the family (`sockaddr-in`, ...).
  /// @ptr(const sockaddr)
  type const-sockaddr-ptr = uptr;

  /// @ptr(mut user-msghdr)
  type user-msghdr-ptr = uptr;

  /// @ptr(const user-msghdr)
  type const-user-msghdr-ptr = uptr;

  /// @ptr(mut mmsghdr[])
  type mmsghdr-array = uptr;

  /// @ptr(mut msqid64-ds)
  type msqid64-ds-ptr = uptr;

  /// @ptr(mut shmid64-ds)
  type shmid64-ds-ptr = uptr;

  /// @ptr(const sembuf[])
  type const-sembuf-array = uptr;

  /// @ptr(mut msgbuf)
  type msgbuf-ptr = uptr;

  /// @ptr(const msgbuf)
  type const-msgbuf-ptr = uptr;

  /// @ptr(mut mq-attr)
  type mq-attr-ptr = uptr;

  /// @ptr(const mq-attr)
  type const-mq-attr-ptr = uptr;

  /// @ptr(mut iocb)
  type iocb-ptr = uptr;

  /// @ptr(const iocb-ptr[])
  type const-iocb-ptr-array = uptr;

  /// @ptr(mut io-event)
  type io-event-ptr = uptr;

  /// @ptr(mut io-event[])
  type io-event-array = uptr;

  /// @ptr(mut io-uring-params)
  type io-uring-params-ptr = uptr;

  // ==== Errors ====

  /// Error numbers (`asm-generic/errno-base.h`, `asm-generic/errno.h`).
  /// Syscalls return them negated (`-ENOENT`).
  /// @repr(s32)
  /// @c(int)
  /// @abi-error
  enum errno {
    /// @value(1)
    eperm,
    /// @value(2)
    enoent,
    /// @value(3)
    esrch,
    /// @value(4)
    eintr,
    /// @value(5)
    eio,
    /// @value(6)
    enxio,
    /// @value(7)
    e2big,
    /// @value(8)
    enoexec,
    /// @value(9)
    ebadf,
    /// @value(10)
    echild,
    /// @value(11)
    eagain,
    /// @value(11)
    ewouldblock,
    /// @value(12)
    enomem,
    /// @value(13)
    eacces,
    /// @value(14)
    efault,
    /// @value(15)
    enotblk,
    /// @value(16)
    ebusy,
    /// @value(17)
    eexist,
    /// @value(18)
    exdev,
    /// @value(19)
    enodev,
    /// @value(20)
    enotdir,
    /// @value(21)
    eisdir,
    /// @value(22)
    einval,
    /// @value(23)
    enfile,
    /// @value(24)
    emfile,
    /// @value(25)
    enotty,
    /// @value(26)
    etxtbsy,
    /// @value(27)
    efbig,
    /// @value(28)
    enospc,
    /// @value(29)
    espipe,
    /// @value(30)
    erofs,
    /// @value(31)
    emlink,
    /// @value(32)
    epipe,
    /// @value(33)
    edom,
    /// @value(34)
    erange,
    /// @value(35)
    edeadlk,
    /// @value(35)
    edeadlock,
    /// @value(36)
    enametoolong,
    /// @value(37)
    enolck,
    /// @value(38)
    enosys,
    /// @value(39)
    enotempty,
    /// @value(40)
    eloop,
    /// @value(42)
    enomsg,
    /// @value(43)
    eidrm,
    /// @value(44)
    echrng,
    /// @value(45)
    el2nsync,
    /// @value(46)
    el3hlt,
    /// @value(47)
    el3rst,
    /// @value(48)
    elnrng,
    /// @value(49)
    eunatch,
    /// @value(50)
    enocsi,
    /// @value(51)
    el2hlt,
    /// @value(52)
    ebade,
    /// @value(53)
    ebadr,
    /// @value(54)
    exfull,
    /// @value(55)
    enoano,
    /// @value(56)
    ebadrqc,
    /// @value(57)
    ebadslt,
    /// @value(59)
    ebfont,
    /// @value(60)
    enostr,
    /// @value(61)
    enodata,
    /// @value(62)
    etime,
    /// @value(63)
    enosr,
    /// @value(64)
    enonet,
    /// @value(65)
    enopkg,
    /// @value(66)
    eremote,
    /// @value(67)
    enolink,
    /// @value(68)
    eadv,
    /// @value(69)
    esrmnt,
    /// @value(70)
    ecomm,
    /// @value(71)
    eproto,
    /// @value(72)
    emultihop,
    /// @value(73)
    edotdot,
    /// @value(74)
    ebadmsg,
    /// @value(74)
    efsbadcrc,
    /// @value(75)
    eoverflow,
    /// @value(76)
    enotuniq,
    /// @value(77)
    ebadfd,
    /// @value(78)
    eremchg,
    /// @value(79)
    elibacc,
    /// @value(80)
    elibbad,
    /// @value(81)
    elibscn,
    /// @value(82)
    elibmax,
    /// @value(83)
    elibexec,
    /// @value(84)
    eilseq,
    /// @value(85)
    erestart,
    /// @value(86)
    estrpipe,
    /// @value(87)
    eusers,
    /// @value(88)
    enotsock,
    /// @value(89)
    edestaddrreq,
    /// @value(90)
    emsgsize,
    /// @value(91)
    eprototype,
    /// @value(92)
    enoprotoopt,
    /// @value(93)
    eprotonosupport,
    /// @value(94)
    esocktnosupport,
    /// @value(95)
    eopnotsupp,
    /// @value(96)
    epfnosupport,
    /// @value(97)
    eafnosupport,
    /// @value(98)
    eaddrinuse,
    /// @value(99)
    eaddrnotavail,
    /// @value(100)
    enetdown,
    /// @value(101)
    enetunreach,
    /// @value(102)
    enetreset,
    /// @value(103)
    econnaborted,
    /// @value(104)
    econnreset,
    /// @value(105)
    enobufs,
    /// @value(106)
    eisconn,
    /// @value(107)
    enotconn,
    /// @value(108)
    eshutdown,
    /// @value(109)
    etoomanyrefs,
    /// @value(110)
    etimedout,
    /// @value(111)
    econnrefused,
    /// @value(112)
    ehostdown,
    /// @value(113)
    ehostunreach,
    /// @value(114)
    ealready,
    /// @value(115)
    einprogress,
    /// @value(116)
    estale,
    /// @value(117)
    efscorrupted,
    /// @value(117)
    euclean,
    /// @value(118)
    enotnam,
    /// @value(119)
    enavail,
    /// @value(120)
    eisnam,
    /// @value(121)
    eremoteio,
    /// @value(122)
    edquot,
    /// @value(123)
    enomedium,
    /// @value(124)
    emediumtype,
    /// @value(125)
    ecanceled,
    /// @value(126)
    enokey,
    /// @value(127)
    ekeyexpired,
    /// @value(128)
    ekeyrevoked,
    /// @value(129)
    ekeyrejected,
    /// @value(130)
    eownerdead,
    /// @value(131)
    enotrecoverable,
    /// @value(132)
    erfkill,
    /// @value(133)
    ehwpoison,
    /// @value(134)
    eftype,
  }

  // ==== Files, directories and file systems ====

  /// `statx` timestamp (`struct statx_timestamp`).
  /// @c(struct statx_timestamp)
  /// @size(16)
  /// @align(8)
  record statx-timestamp {
    tv-sec: s64,
    tv-nsec: u32,
    /// musl: `__pad`.
    /// @c-name(__pad)
    reserved: s32,
  }

  /// `statx` result (`struct statx`). This is the only stat syscall on riscv32.
  /// @c(struct statx)
  /// @size(256)
  /// @align(8)
  record statx {
    stx-mask: statx-mask,
    stx-blksize: u32,
    stx-attributes: statx-attributes,
    stx-nlink: u32,
    stx-uid: uid,
    stx-gid: gid,
    stx-mode: u16,
    /// musl: `__pad0`.
    /// @c-name(__pad0)
    spare0: list<u16, 1>,
    stx-ino: u64,
    stx-size: u64,
    stx-blocks: u64,
    stx-attributes-mask: statx-attributes,
    stx-atime: statx-timestamp,
    stx-btime: statx-timestamp,
    stx-ctime: statx-timestamp,
    stx-mtime: statx-timestamp,
    stx-rdev-major: u32,
    stx-rdev-minor: u32,
    stx-dev-major: u32,
    stx-dev-minor: u32,
    stx-mnt-id: u64,
    stx-dio-mem-align: u32,
    stx-dio-offset-align: u32,
    stx-subvol: u64,
    stx-atomic-write-unit-min: u32,
    stx-atomic-write-unit-max: u32,
    stx-atomic-write-segments-max: u32,
    /// No C assert: newer than musl 1.2.6, whose `struct statx` has `__pad1`/`__pad2` here.
    /// @c-skip
    stx-dio-read-offset-align: u32,
    /// No C assert: newer than musl 1.2.6 (inside musl's `__pad2`).
    /// @c-skip
    stx-atomic-write-unit-max-opt: u32,
    /// No C assert: inside musl's `__pad2`.
    /// @c-skip
    /// @c-name(__spare2)
    spare2: list<u32, 1>,
    /// No C assert: inside musl's `__pad2`.
    /// @c-skip
    /// @c-name(__spare3)
    spare3: list<u64, 8>,
  }

  /// File system id (`__kernel_fsid_t`).
  /// @c(fsid_t)
  /// @size(8)
  /// @align(4)
  record kernel-fsid {
    /// @c-name(__val)
    val: list<s32, 2>,
  }

  /// `statfs64`/`fstatfs64` result (asm-generic `struct statfs64`). The `sz` argument must be 88.
  /// @c(struct statfs)
  /// @size(88)
  /// @align(8)
  record statfs64 {
    f-type: u32,
    f-bsize: u32,
    f-blocks: u64,
    f-bfree: u64,
    f-bavail: u64,
    f-files: u64,
    f-ffree: u64,
    f-fsid: kernel-fsid,
    f-namelen: u32,
    f-frsize: u32,
    f-flags: u32,
    f-spare: list<u32, 4>,
  }

  /// Legacy lock with 32-bit offsets (`struct flock`), only reachable with kernel `F_GETLK` (5)..
  /// `F_SETLKW` (7). musl's `struct flock` is the 64-bit `flock64`.
  /// @kernel-only
  /// @size(16)
  /// @align(4)
  record flock {
    l-type: lock-type,
    l-whence: s16,
    l-start: slong,
    l-len: slong,
    l-pid: pid,
  }

  /// File lock for `F_GETLK64`..`F_SETLKW64` and the `F_OFD_*` commands (`struct flock64`).
  /// 4 bytes of implicit padding follow `l-whence` and `l-pid`.
  /// @c(struct flock)
  /// @size(32)
  /// @align(8)
  record flock64 {
    l-type: lock-type,
    l-whence: s16,
    l-start: loff,
    l-len: loff,
    l-pid: pid,
  }

  /// `F_GETOWN_EX`/`F_SETOWN_EX` argument (`struct f_owner_ex`).
  /// @c(struct f_owner_ex)
  /// @size(8)
  /// @align(4)
  record f-owner-ex {
    %type: f-owner-type,
    pid: pid,
  }

  /// Header of a `getdents64` record (`struct linux_dirent64`). The NUL-terminated `d_name`
  /// starts at offset 19; `d-reclen` covers the name and pads the record to 8 bytes.
  /// @kernel-only
  /// @size(24)
  /// @align(8)
  record linux-dirent64 {
    d-ino: u64,
    d-off: s64,
    d-reclen: u16,
    d-type: u8,
  }

  /// Header of `struct file_handle`; `handle-bytes` opaque bytes follow at offset 8.
  /// @c(struct file_handle)
  /// @size(8)
  /// @align(4)
  record file-handle {
    handle-bytes: u32,
    handle-type: s32,
  }

  /// `openat2` arguments (`struct open_how`); `usize` must be >= 24.
  /// @kernel-only
  /// @size(24)
  /// @align(8)
  record open-how {
    /// `open-flags` (zero-extended).
    %flags: u64,
    mode: u64,
    resolve: resolve-flags,
  }

  /// Scatter/gather element (`struct iovec`).
  /// @c(struct iovec)
  /// @size(8)
  /// @align(4)
  record iovec {
    iov-base: uptr,
    iov-len: usize,
  }

  /// `setxattrat`/`getxattrat` arguments (`struct xattr_args`).
  /// @kernel-only
  /// @size(16)
  /// @align(8)
  record xattr-args {
    /// Guest address of the value buffer, zero-extended.
    value: u64,
    size: u32,
    /// `xattr-flags` bits.
    %flags: u32,
  }

  /// `file_getattr`/`file_setattr` attributes (`struct file_attr`).
  /// @kernel-only
  /// @size(24)
  /// @align(8)
  record file-attr {
    fa-xflags: u64,
    fa-extsize: u32,
    fa-nextents: u32,
    fa-projid: u32,
    fa-cowextsize: u32,
  }

  /// `cachestat` range (`struct cachestat_range`).
  /// @kernel-only
  /// @size(16)
  /// @align(8)
  record cachestat-range {
    off: u64,
    len: u64,
  }

  /// `cachestat` result (`struct cachestat`).
  /// @kernel-only
  /// @size(40)
  /// @align(8)
  record cachestat {
    nr-cache: u64,
    nr-dirty: u64,
    nr-writeback: u64,
    nr-evicted: u64,
    nr-recently-evicted: u64,
  }

  /// Header of an LSM context (`struct lsm_ctx`); `ctx-len` bytes of context follow at offset 32.
  /// @kernel-only
  /// @size(32)
  /// @align(8)
  record lsm-ctx {
    id: u64,
    %flags: u64,
    len: u64,
    ctx-len: u64,
  }

  /// `landlock_create_ruleset` attributes (`struct landlock_ruleset_attr`, size-versioned).
  /// @kernel-only
  /// @size(48)
  /// @align(8)
  record landlock-ruleset-attr {
    handled-access-fs: u64,
    handled-access-net: u64,
    scoped: u64,
    quiet-access-fs: u64,
    quiet-access-net: u64,
    quiet-scoped: u64,
  }

  /// `LANDLOCK_RULE_NET_PORT` rule (`struct landlock_net_port_attr`).
  /// `LANDLOCK_RULE_PATH_BENEATH` uses a packed 12-byte struct that WIT records cannot express.
  /// @kernel-only
  /// @size(16)
  /// @align(8)
  record landlock-net-port-attr {
    allowed-access: u64,
    port: u64,
  }

  /// Header of an inotify event (`struct inotify_event`); `len` bytes of name follow at offset 16.
  /// @c(struct inotify_event)
  /// @size(16)
  /// @align(4)
  record inotify-event {
    wd: s32,
    mask: inotify-mask,
    cookie: u32,
    len: u32,
  }

  /// fanotify event header (`struct fanotify_event_metadata`).
  /// @c(struct fanotify_event_metadata)
  /// @size(24)
  /// @align(8)
  record fanotify-event-metadata {
    event-len: u32,
    vers: u8,
    reserved: u8,
    metadata-len: u16,
    mask: u64,
    fd: s32,
    pid: s32,
  }

  /// `O_*` flags for `openat`, `openat2` (low 32 bits), `pipe2`, `dup3`, `mq_open` (`asm-generic/fcntl.h`).
  /// `O_RDONLY`/`O_WRONLY`/`O_RDWR` are values of the `O_ACCMODE` field, not bits.
  /// @repr(u32)
  /// @c(int)
  flags open-flags {
    /// @value(0x0)
    o-rdonly,
    /// @value(0x1)
    o-wronly,
    /// @value(0x2)
    o-rdwr,
    /// @value(0x3)
    /// No C assert: musl adds `O_PATH` to `O_ACCMODE` (`03|O_PATH`); the kernel mask is 3.
    /// @c-skip
    o-accmode,
    /// @value(0x40)
    o-creat,
    /// @value(0x80)
    o-excl,
    /// @value(0x100)
    o-noctty,
    /// @value(0x200)
    o-trunc,
    /// @value(0x400)
    o-append,
    /// @value(0x800)
    o-ndelay,
    /// @value(0x800)
    o-nonblock,
    /// @value(0x1000)
    o-dsync,
    /// @value(0x4000)
    o-direct,
    /// @value(0x8000)
    o-largefile,
    /// @value(0x10000)
    o-directory,
    /// @value(0x20000)
    o-nofollow,
    /// @value(0x40000)
    o-noatime,
    /// @value(0x80000)
    o-cloexec,
    /// @name(__O_SYNC)
    /// @value(0x100000)
    o-sync-bit,
    /// @value(0x101000)
    o-sync,
    /// @value(0x200000)
    o-path,
    /// @name(__O_TMPFILE)
    /// @value(0x400000)
    o-tmpfile-bit,
    /// @value(0x410000)
    o-tmpfile,
    /// @value(0x4000000)
    o-emptypath,
  }

  /// Special directory file descriptor values for `*at` syscalls (`linux/fcntl.h`).
  /// @repr(s32)
  /// @c(int)
  enum at-fd {
    /// @value(-100)
    at-fdcwd,
  }

  /// Special pidfd values that name the caller (`linux/fcntl.h`), for the calls that take a
  /// pidfd (`pidfd_send_signal`, `pidfd_getfd`, `process_madvise`, ...).
  /// @repr(s32)
  /// @c(int)
  enum pidfd-self {
    /// @value(-10000)
    pidfd-self-thread,
    /// @value(-10001)
    pidfd-self-thread-group,
  }

  /// `AT_*` flags for `*at` syscalls (`linux/fcntl.h`).
  /// Some bits are reused with different meanings by individual syscalls (`AT_EACCESS` == `AT_REMOVEDIR`).
  /// @repr(u32)
