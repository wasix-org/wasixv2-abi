    /// @value(0x400)
    fs-xflag-nosymlinks,
    /// @value(0x800)
    fs-xflag-extsize,
    /// @value(0x1000)
    fs-xflag-extszinherit,
    /// @value(0x2000)
    fs-xflag-nodefrag,
