    landlock-restrict-self-log-subdomains-off,
    /// @value(0x8)
    landlock-restrict-self-tsync,
    /// @value(0x10)
    landlock-restrict-self-no-new-privs,
  }

  /// `landlock_add_rule` rule types (`enum landlock_rule_type`).
  /// @repr(s32)
  /// @c(int)
  enum landlock-rule-type {
    /// @value(1)
    landlock-rule-path-beneath,
    /// @value(2)
    landlock-rule-net-port,
  }

  /// Filesystem access rights (`LANDLOCK_ACCESS_FS_*`, `linux/landlock.h`).
  /// @repr(u64)
  flags landlock-access-fs {
    /// @value(0x1)
    landlock-access-fs-execute,
    /// @value(0x2)
    landlock-access-fs-write-file,
    /// @value(0x4)
    landlock-access-fs-read-file,
    /// @value(0x8)
    landlock-access-fs-read-dir,
    /// @value(0x10)
    landlock-access-fs-remove-dir,
    /// @value(0x20)
    landlock-access-fs-remove-file,
    /// @value(0x40)
    landlock-access-fs-make-char,
    /// @value(0x80)
    landlock-access-fs-make-dir,
    /// @value(0x100)
    landlock-access-fs-make-reg,
    /// @value(0x200)
    landlock-access-fs-make-sock,
    /// @value(0x400)
    landlock-access-fs-make-fifo,
    /// @value(0x800)
    landlock-access-fs-make-block,
    /// @value(0x1000)
    landlock-access-fs-make-sym,
    /// @value(0x2000)
    landlock-access-fs-refer,
    /// @value(0x4000)
    landlock-access-fs-truncate,
    /// @value(0x8000)
    landlock-access-fs-ioctl-dev,
    /// @value(0x10000)
    landlock-access-fs-resolve-unix,
  }

  /// Network access rights (`LANDLOCK_ACCESS_NET_*`, `linux/landlock.h`).
  /// @repr(u64)
  flags landlock-access-net {
    /// @value(0x1)
    landlock-access-net-bind-tcp,
    /// @value(0x2)
    landlock-access-net-connect-tcp,
    /// @value(0x4)
    landlock-access-net-bind-udp,
    /// @value(0x8)
    landlock-access-net-connect-send-udp,
  }

  /// IPC scopes (`LANDLOCK_SCOPE_*`, `linux/landlock.h`).
  /// @repr(u64)
  flags landlock-scope {
    /// @value(0x1)
    landlock-scope-abstract-unix-socket,
    /// @value(0x2)
    landlock-scope-signal,
  }

  /// `LANDLOCK_RULE_PATH_BENEATH` rule (`struct landlock_path_beneath_attr`), packed: 12 bytes
  /// at any alignment.
  /// @kernel-only
  /// @size(12)
  /// @align(1)
  record landlock-path-beneath-attr {
    allowed-access: list<u8, 8>,
    parent-fd: list<u8, 4>,
  }

  /// Special key and keyring ids (`KEY_SPEC_*`, `linux/keyctl.h`).
  /// @repr(s32)
  /// @c(int)
  enum key-spec {
    /// @value(-1)
    key-spec-thread-keyring,
    /// @value(-2)
    key-spec-process-keyring,
    /// @value(-3)
    key-spec-session-keyring,
    /// @value(-4)
    key-spec-user-keyring,
    /// @value(-5)
    key-spec-user-session-keyring,
    /// @value(-6)
    key-spec-group-keyring,
    /// @value(-7)
    key-spec-reqkey-auth-key,
    /// @value(-8)
    key-spec-requestor-keyring,
  }

  /// `KEYCTL_SET_REQKEY_KEYRING` defaults (`KEY_REQKEY_DEFL_*`, `linux/keyctl.h`).
  /// @repr(s32)
  /// @c(int)
  enum key-reqkey-defl {
    /// @value(-1)
    key-reqkey-defl-no-change,
    /// @value(0)
    key-reqkey-defl-default,
    /// @value(1)
    key-reqkey-defl-thread-keyring,
    /// @value(2)
    key-reqkey-defl-process-keyring,
    /// @value(3)
    key-reqkey-defl-session-keyring,
    /// @value(4)
    key-reqkey-defl-user-keyring,
